---
import Contact from "../../components/Contact.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localeStaticPaths, pageTitle, t, type Locale } from "../../i18n";

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY?.trim();
---

<BaseLayout
  {lang}
  title={pageTitle(copy.meta.pages.contactTitle, lang)}
  description={copy.meta.pages.contactDescription}
  canonicalPath="/contact/"
>
  {
    turnstileSiteKey && (
      <script
        is:inline
        slot="head"
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
      />
    )
  }
  <main id="main-content" class="page-shell">
    <Contact {lang} {turnstileSiteKey} />
  </main>
</BaseLayout>
