---
import { getCollection } from "astro:content";
import Footer from "../../components/Footer.astro";
import ProjectsIndex from "../../components/projects/ProjectsIndex";
import TypedFallback from "../../components/text/TypedFallback.astro";
import TypedHead from "../../components/text/TypedHead";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localeStaticPaths, localizedPath, pageTitle, t, type Locale } from "../../i18n";
import type { ProjectSummary } from "../../lib/projects";
import { byEvidence, previewFor } from "../../lib/projects";
import "../../styles/projects-index.css";
import "../../styles/text-type.css";

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang);

/**
 * Display-only projection. The island receives exactly these fields — the
 * private store's attribution and impact prose has already been withheld by
 * the exporter, and nothing here widens that surface.
 */
const projects: ProjectSummary[] = (await getCollection("projects"))
  .map((entry) => {
    const d = entry.data;
    const c = d.copy[lang];
    return {
      slug: entry.id,
      title: c.title,
      tagline: c.tagline,
      stack: d.stack,
      preview: previewFor(d, lang),
      previewAlt: c.previewAlt,
      liveUrl: d.liveUrl,
      liveLabel: c.liveLabel,
      evidenceLink: d.evidenceLink ?? null,
      evidenceLabel: c.evidenceLabel ?? null,
      dates: d.dates,
      evidenceWeight: d.evidenceWeight,
      evidenceSignals: d.evidenceSignals,
      hasCaseStudy: d.caseStudy !== null,
      href: localizedPath(`/projects/${entry.id}/`, lang),
    };
  })
  .sort(byEvidence);
---

<BaseLayout
  {lang}
  title={pageTitle(copy.meta.pages.projectsTitle, lang)}
  description={copy.meta.pages.projectsDescription}
  canonicalPath="/projects/"
>
  <main id="main-content" class="page-shell">
    <header class="pindex-head">
      <TypedFallback />
      <TypedHead
        client:load
        title={copy.projects.index.heading}
        lede={copy.meta.pages.projectsDescription}
        titleClassName="pindex-head__title"
        ledeClassName="pindex-head__lede"
      />
    </header>
    <ProjectsIndex client:load projects={projects} copy={copy.projects.index} />
    <Footer {lang} />
  </main>
</BaseLayout>

<style>
  /*
   * The navbar is position:fixed and is not in flow — 98px up to the tablet
   * breakpoint, 134px above it — so every page owns its own clearance. At the
   * previous 64px the heading rendered underneath it.
   */
  .pindex-head {
    max-width: var(--container-content);
    margin: 0 auto;
    padding: var(--space-px-120) var(--space-px-16) var(--space-px-40);
  }

  :global(.pindex-head__title) {
    margin: 0 0 var(--space-px-12);
    font-family: var(--font-display);
    font-size: var(--type-heading-mobile-size);
    font-weight: var(--font-weight-regular);
    line-height: var(--type-heading-mobile-leading);
    color: var(--text-heading);
  }

  :global(.pindex-head__lede) {
    max-width: var(--content-copy);
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--type-body-mobile-size);
    line-height: var(--type-body-mobile-leading);
    color: var(--text-primary);
  }

  @media (min-width: 768px) {
    .pindex-head {
      padding: var(--space-px-128) var(--space-px-48) var(--space-px-48);
    }

    :global(.pindex-head__title) {
      font-size: var(--type-heading-size);
      line-height: var(--type-heading-leading);
    }

    :global(.pindex-head__lede) {
      font-size: var(--type-body-size);
      line-height: var(--type-body-leading);
    }
  }

  @media (min-width: 1280px) {
    .pindex-head {
      padding-top: var(--space-px-170);
      padding-inline: var(--space-px-64);
    }
  }
</style>
