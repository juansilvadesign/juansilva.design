---
import Footer from "../../components/Footer.astro";
import Projects from "../../components/Projects.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localeStaticPaths, pageTitle, t, type Locale } from "../../i18n";

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang);
---

<BaseLayout
  {lang}
  title={pageTitle(copy.meta.pages.projectsTitle, lang)}
  description={copy.meta.pages.projectsDescription}
  canonicalPath="/projects/"
>
  <main id="main-content" class="page-shell">
    <h1 class="visually-hidden">{copy.meta.pages.projectsTitle}</h1>
    <Projects {lang} />
    <Footer {lang} />
  </main>
</BaseLayout>
