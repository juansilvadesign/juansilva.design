---
import { getCollection } from "astro:content";
import Footer from "../../../components/Footer.astro";
import SourceCodeButton from "../../../components/SourceCodeButton.astro";
import StackBadge from "../../../components/StackBadge.astro";
import BackToTop from "../../../components/BackToTop.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { locales, defaultLocale, localizedPath, pageTitle, t } from "../../../i18n";
import { existsSync } from "node:fs";
import { join, resolve } from "node:path";
import { PREVIEW_MOTION_TYPES, SIGNAL_FACETS, byEvidence, formatTimeframe, isVideoPreview, motionPreviewFor, ogImageFor, posterFor, previewFor } from "../../../lib/projects";
import "../../../styles/evidence-rail.css";
import "../../../styles/action-row.css";

export async function getStaticPaths() {
  const entries = await getCollection("projects");
  return locales.flatMap((lang) =>
    entries.map((entry) => ({
      params: { lang: lang === defaultLocale ? undefined : lang, slug: entry.id },
      props: { lang, entry },
    })),
  );
}

const { lang, entry } = Astro.props;
const copy = t(lang);
const d = entry.data;
const c = d.copy[lang];
const detail = copy.projects.detail;

/** Shared with the featured card, so the two surfaces cannot drift. */
const timeframe = formatTimeframe(d.dates, lang, detail);

/**
 * The hero visual. A record may ship a video preview — `price-watcher-ticket-autobuy`
 * is the first — and the card has rendered those as `<video>` since it was
 * written, so the detail page had been the odd one out, silently degrading a
 * moving hero to a still frame.
 */
const preview = previewFor(d, lang);

/**
 * The record's moving preview, where it ships one — the same asset the homepage
 * card plays on hover, so a visitor who arrived by clicking that card already
 * holds it in cache.
 *
 * It takes precedence over the two branches below and brings its own poster, so
 * neither `posterFor`'s naming convention nor its build-time existence check
 * applies: `previewMotion.poster` is a schema field the store validates.
 *
 * Unlike the card, this one plays from the first frame. The card seeks past the
 * fade-in because it is swapping out of a still and a dark opening reads as the
 * card breaking; here the fade-in IS the opening of the piece.
 */
const motion = motionPreviewFor(d, lang);

const isVideo = isVideoPreview(preview);
const poster = isVideo ? posterFor(preview) : undefined;

/**
 * This page's own social card: the hero poster, where the record ships one.
 *
 * Null on every record that does not, and null is the right answer — the caller
 * then falls through to the site-wide og-image, which is a real 1200x630 file.
 * Handing a scraper the SVG placeholder that 36 records carry as their preview
 * would unfurl worse than the default it replaced, so `ogImageFor` refuses
 * anything but JPEG and PNG.
 *
 * Costs a visitor nothing: `og:image` is fetched by crawlers and chat
 * unfurlers, never by a browser rendering this page.
 */
const ogImage = ogImageFor(d, lang);

/**
 * `posterFor` is a naming convention, not a schema field, so nothing else can
 * catch a missing file: the attribute would just 404 and the video would fall
 * back to its own first frame — which is exactly the blank frame the poster
 * exists to avoid. Root-relative previews resolve inside `public/`.
 *
 * ⛔ Resolved from `process.cwd()`, not from `import.meta.url`. Astro serves
 * this module from a compiled chunk, so a path walked up from `import.meta.url`
 * lands outside the project and reports every poster missing — which is what
 * the first version of this check did, on a file that was sitting right there.
 *
 * And when `public/` itself cannot be found, the check yields rather than
 * warning: "I could not look" is not "I looked and it is not there", and a
 * guard that cannot tell those apart teaches you to ignore it.
 */
const PUBLIC_DIR = resolve(process.cwd(), "public");

const posterHref = (() => {
  if (!poster) return undefined;
  if (!poster.startsWith("/")) return poster;
  if (!existsSync(PUBLIC_DIR)) return poster;
  if (existsSync(join(PUBLIC_DIR, poster))) return poster;
  console.warn(
    `[projects] ${entry.id}: video preview "${preview}" has no poster at ` +
      `public${poster} — viewers who block autoplay will see its first frame.`,
  );
  return undefined;
})();

const signals = SIGNAL_FACETS.filter((s) => d.evidenceSignals[s]);

/**
 * The store's verdict decides the control; the link only says where it goes.
 * Seven records carry the flag, so this is 14 pages across the two locales.
 */
const hasSource = d.evidenceSignals.sourceCode && Boolean(d.evidenceLink);

if (d.evidenceSignals.sourceCode && !d.evidenceLink) {
  console.warn(
    `[projects] ${entry.id}: evidenceSignals.sourceCode is true but the record ` +
      `carries no evidenceLink — the case-study page shows no source control.`,
  );
}

/** "Next" follows the same evidence order the index uses, so the two agree. */
const ordered = (await getCollection("projects")).sort((a, b) =>
  byEvidence(
    { ...a.data, slug: a.id } as never,
    { ...b.data, slug: b.id } as never,
  ),
);
const at = ordered.findIndex((e) => e.id === entry.id);
const next = ordered[(at + 1) % ordered.length];

const indexHref = localizedPath("/projects/", lang);
---

<BaseLayout
  {lang}
  title={pageTitle(c.title, lang)}
  description={c.tagline}
  canonicalPath={`/projects/${entry.id}/`}
  image={ogImage?.url}
  imageWidth={ogImage?.width}
  imageHeight={ogImage?.height}
  imageAlt={ogImage ? c.previewAlt : undefined}
>
  <main id="main-content" class="page-shell">
    <article class="case">
      <nav class="case__back" aria-label={detail.backToIndex}>
        <a href={indexHref}>← {detail.backToIndex}</a>
      </nav>

      <!-- 1 · Hero -->
      <header class="case__hero">
        <h1 class="case__title">{c.title}</h1>
        <p class="case__dek">{c.tagline}</p>
      </header>

      <figure class="case__media">
        {motion ? (
          /*
            Same two-element shape as the `cs-loop` figures further down, and for
            the same reason: `media` on <source> is NOT honoured inside <video>
            (only inside <picture>), so the reduced-motion branch has to be a CSS
            display swap over a real image. That keeps this page at zero
            first-party JS — the hero autoplays or it doesn't, and either way
            what stands in its place is the poster rather than a black box.
          */
          <div class="hero-loop">
            {/*
              Started by the observer, like the body loops — even though this one
              is above the fold and its IntersectionObserver fires on the first
              frame, so there is no perceptible delay.

              ⛔ It is here for the reduced-motion case, not for laziness.
              MEASURED: with `autoplay`, this clip was fetched in full (9.4 MB) by
              viewers who had asked for less motion and were being shown the still
              instead — `display: none` does not stop a fetch that `autoplay`
              started. The script returns early on that query, so now nothing is
              requested at all.
            */}
            <video
              class="hero-loop__motion"
              data-scroll-loop
              muted
              loop
              playsinline
              preload="none"
              poster={motion.poster}
              width={motion.width}
              height={motion.height}
              aria-label={c.previewAlt}
            >
              <source src={motion.webm} type={PREVIEW_MOTION_TYPES.webm} />
              <source src={motion.mp4} type={PREVIEW_MOTION_TYPES.mp4} />
            </video>
            {/*
              The still a reduced-motion viewer gets instead. WebP first, the
              record's own `preview` as the universal fallback — the same pair
              the homepage card sits on, encoded from one source frame.
            */}
            <picture>
              <source srcset={motion.poster} type="image/webp" />
              <img
                class="hero-loop__still"
                src={preview}
                alt={c.previewAlt}
                width={motion.width}
                height={motion.height}
                decoding="async"
              />
            </picture>
          </div>
        ) : isVideo ? (
          <video
            src={preview}
            poster={posterHref}
            muted
            loop
            playsinline
            autoplay
            preload="metadata"
            width="1600"
            height="900"
            aria-label={c.previewAlt}
          />
        ) : (
          <img src={preview} alt={c.previewAlt} width="1600" height="900" decoding="async" />
        )}
      </figure>

      <!-- 2 · Statement band -->
      <p class="case__statement">{c.description}</p>

      <!-- 3 · Project brief, entirely from the record -->
      <section class="brief" aria-label={detail.briefLegend}>
        <dl class="brief__list">
          <div class="brief__row">
            <dt>{detail.roleLabel}</dt>
            <dd>{d.role}</dd>
          </div>
          {timeframe && (
            <div class="brief__row">
              <dt>{detail.timeframeLabel}</dt>
              <dd>{timeframe}</dd>
            </div>
          )}
          <div class="brief__row">
            <dt>{detail.stackLabel}</dt>
            <dd class="brief__stack" role="list">
              {d.stack.map((s) => <StackBadge id={s} />)}
            </dd>
          </div>
          {signals.length > 0 && (
            <div class="brief__row">
              <dt>{detail.evidenceLabel}</dt>
              <dd>
                <ul class="rail">
                  {signals.map((s) => (
                    <li class="rail__item" data-signal={s}>
                      <span aria-hidden="true" class="rail__dot" />
                      {copy.projects.index.signalsShort[s]}
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
        </dl>

        {/* Slot two is the source-code control on the records that assert it,
            and the record's own evidence link on the rest. The 27 non-repo
            links here are Figma files and archive snapshots — a GitHub-marked
            button on those would misdescribe what sits behind them. */}
        <p class="brief__actions">
          <a class="button" href={d.liveUrl} rel="noopener noreferrer" target="_blank">{c.liveLabel}</a>
          {hasSource ? (
            <SourceCodeButton {lang} href={d.evidenceLink as string} slug={entry.id} />
          ) : (
            d.evidenceLink && c.evidenceLabel && (
              <a class="button button--secondary" href={d.evidenceLink} rel="noopener noreferrer" target="_blank">
                {c.evidenceLabel}
              </a>
            )
          )}
        </p>
      </section>

      <!-- 4 · Narrative, or an honest placeholder -->
      {d.caseStudy ? (
        <div class="case__body">
          <p class="case__lead">{d.caseStudy[lang].brief}</p>
          <p>{d.caseStudy[lang].context}</p>

          {d.caseStudy[lang].sections?.map((s) => (
            <>
              <h2>{s.heading}</h2>
              <p>{s.body}</p>
            </>
          ))}

          {/* The long form, in authored order. Images break the reading column
              deliberately; everything else stays inside the measure. */}
          {d.caseStudy[lang].blocks?.map((b) =>
            b.type === "heading" ? (
              b.level === 2 ? <h2>{b.text}</h2> : <h3>{b.text}</h3>
            ) : b.type === "prose" ? (
              <p>{b.body}</p>
            ) : b.type === "callout" ? (
              <aside class="cs-callout">{b.body}</aside>
            ) : b.type === "quote" ? (
              <figure class="cs-quote">
                <blockquote>{b.text}</blockquote>
                {b.source && <figcaption>{b.source}</figcaption>}
              </figure>
            ) : b.type === "list" ? (
              b.ordered ? (
                <ol class="cs-list">{b.items.map((it) => <li>{it}</li>)}</ol>
              ) : (
                <ul class="cs-list">{b.items.map((it) => <li>{it}</li>)}</ul>
              )
            ) : b.type === "statRow" ? (
              <dl class="cs-stats" style={`--cs-stat-cols:${b.items.length}`}>
                {b.items.map((it) => (
                  <div class="cs-stat">
                    <dt>
                      {it.icon && <span class="cs-stat__icon" aria-hidden="true">{it.icon}</span>}
                      {it.value}
                    </dt>
                    {it.label && <dd>{it.label}</dd>}
                  </div>
                ))}
              </dl>
            ) : b.type === "video" ? (
              <figure class="cs-figure cs-loop">
                {/*
                  Silent inline loop. Two elements, not one: `media` on <source> is
                  NOT honoured inside <video> (unlike inside <picture>), so the
                  reduced-motion branch has to be a CSS display swap over a real
                  <img>. That keeps this page at zero first-party JS.

                  The codecs strings are load-bearing. The WebM is VP9 Profile 1
                  (4:4:4) — a bare type="video/webm" lets a browser claim support by
                  MIME, fail to decode the profile, and render nothing, with the mp4
                  fallback never firing.
                */}
                {/*
                  ⛔ NO `autoplay`, and that is the whole optimisation. MEASURED
                  2026-09-13: with it, this clip was fetched IN FULL on load —
                  31.6 MB, readyState 4 — while sitting 1330px below the fold and
                  paused, taking the page to 40.2 MB. The browser defers offscreen
                  auto*play* but not the auto*load* that `autoplay` implies.
                  `preload` does NOT govern this: "none" and "metadata" both
                  fetched all 31.6 MB. Removing the attribute drops the same page
                  to 9.3 MB, and the observer below starts the clip when a reader
                  actually reaches it.

                  ⛔ Do not re-add `autoplay` to "fix" a clip that does not play,
                  and do not touch `preload` — it is inert while autoplay is set.
                  If it stopped playing, the script is what broke.
                */}
                <video
                  class="cs-loop__motion"
                  data-scroll-loop
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={b.poster}
                  width={b.width}
                  height={b.height}
                  aria-label={b.alt}
                >
                  <source src={b.webm} type='video/webm; codecs="vp09.01.41.08"' />
                  <source src={b.mp4} type='video/mp4; codecs="avc1.640029"' />
                </video>
                <img
                  class="cs-loop__still"
                  src={b.poster}
                  alt={b.alt}
                  width={b.width}
                  height={b.height}
                  loading="lazy"
                  decoding="async"
                />
                {b.caption && <figcaption>{b.caption}</figcaption>}
              </figure>
            ) : (
              <figure
                class:list={[
                  "cs-figure",
                  b.width && b.height && b.height > b.width && "cs-figure--portrait",
                ]}
              >
                <img
                  src={b.src}
                  alt={b.alt}
                  width={b.width}
                  height={b.height}
                  loading="lazy"
                  decoding="async"
                />
                {b.caption && <figcaption>{b.caption}</figcaption>}
              </figure>
            ),
          )}

          <h2>{detail.evidenceLabel}</h2>
          <p>{d.caseStudy[lang].outcome}</p>
        </div>
      ) : (
        <aside class="soon">
          <p class="soon__title">{detail.caseInProgress}</p>
          <p class="soon__body">{detail.caseInProgressBody}</p>
        </aside>
      )}

      <!-- 5 · Next -->
      <nav class="case__next" aria-label={detail.nextProject}>
        <a href={localizedPath(`/projects/${next.id}/`, lang)}>
          <span class="case__next-label">{detail.nextProject}</span>
          <span class="case__next-title">{next.data.copy[lang].title} →</span>
        </a>
      </nav>
    </article>
    <Footer {lang} />
  </main>

  {/* uiverse-5. Outside <main> so the fixed control is not itself a target
      of the #main-content jump it performs. */}
  <BackToTop {lang} />

  {/*
    The only first-party script this page carries, and it buys 31.6 MB back on
    the upOS case study. It starts each inline loop when the reader reaches it
    and pauses it when they leave.

    ⛔ Reduced motion returns before observing anything. Those viewers are served
    the still by CSS, so the clip must never be fetched for them at all — and a
    `display: none` element has no intersection box, which would silently do the
    right thing here and be the wrong thing to rely on.

    With no JS the loop never starts, which is exactly why `<html>` ships
    `no-js`: the stylesheet then paints the still instead, the same one reduced
    motion gets.
  */}
  <script>
    (() => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const loops = document.querySelectorAll("video[data-scroll-loop]");
      if (loops.length === 0) return;

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const video = entry.target;
            if (!(video instanceof HTMLVideoElement)) continue;
            if (entry.isIntersecting) {
              // preload="none" in the markup, so this is the first byte fetched.
              if (video.preload !== "auto") video.preload = "auto";
              video.play().catch(() => {
                /* Refused even muted — the poster stands in, which is correct. */
              });
            } else {
              video.pause();
            }
          }
        },
        // A margin, so the clip is already running by the time it is on screen
        // rather than starting the moment its first pixel appears.
        { rootMargin: "200px 0px" },
      );

      for (const loop of loops) observer.observe(loop);
    })();
  </script>
</BaseLayout>

<style>
  /* Reading column follows the system's own measure, not the reference's. */
  /* Clears the fixed navbar — see the note on .pindex-head. */
  .case {
    max-width: var(--container-content);
    margin: 0 auto;
    padding: var(--space-px-120) var(--space-px-16) var(--space-px-64);
  }

  .case__back {
    margin-bottom: var(--space-px-32);
    font-family: var(--font-meta);
    font-size: var(--type-meta-size);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .case__back a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .case__back a:hover {
    color: var(--primary-ink);
  }

  .case__hero {
    max-width: var(--content-copy);
    margin: 0 auto var(--space-px-40);
    text-align: center;
  }

  .case__title {
    margin: 0 0 var(--space-px-16);
    font-family: var(--font-display);
    font-size: var(--type-heading-mobile-size);
    font-weight: var(--font-weight-regular);
    line-height: var(--type-heading-mobile-leading);
    color: var(--text-heading);
    text-wrap: balance;
  }

  .case__dek {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-18);
    line-height: var(--leading-28);
    color: var(--text-secondary);
  }

  /* Full-bleed media intentionally exceeds the reading column. */
  .case__media {
    margin: 0 0 var(--space-px-48);
  }

  .case__media img,
  .case__media video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-media);
  }

  /*
   * The hero's motion/still swap. A display toggle rather than an overlay: both
   * elements carry the record's own width/height and the rule above sizes them
   * identically, so whichever one paints occupies exactly the same box and the
   * page does not reflow between them.
   *
   * ⛔ Scoped through `.case__media` on purpose. `.hero-loop__still` alone is
   * one class and loses to `.case__media img` above, which is a class plus a
   * type — the still would then paint over the video on every visit, which is
   * the precise opposite of what this rule is for.
   */
  .case__media .hero-loop__still {
    display: none;
  }

  /*
   * An autoplaying loop has no controls and no pause, so a viewer who asked for
   * less motion has no way out of it. Serve the poster instead — the same call
   * the `cs-loop` figures make, for the same reason.
   */
  @media (prefers-reduced-motion: reduce) {
    .case__media .hero-loop__motion {
      display: none;
    }

    .case__media .hero-loop__still {
      display: block;
    }
  }

  /*
   * The hero no longer carries `autoplay` — see the note at its markup — so
   * without scripting it would sit on a poster that never moves. Paint the
   * still instead, exactly as reduced motion does.
   */
  :global(.no-js) .case__media .hero-loop__motion {
    display: none;
  }

  :global(.no-js) .case__media .hero-loop__still {
    display: block;
  }

  .case__statement {
    max-width: var(--content-copy);
    margin: 0 auto var(--space-px-48);
    font-family: var(--font-display);
    font-size: var(--text-20);
    line-height: var(--leading-32);
    color: var(--text-primary);
  }

  .brief {
    max-width: var(--content-copy);
    margin: 0 auto var(--space-px-48);
    border-block: var(--border-width) solid var(--border-subtle);
  }

  .brief__list {
    margin: 0;
    padding: var(--space-px-24) 0;
  }

  .brief__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-px-4);
    padding: var(--space-px-12) 0;
  }

  .brief__row dt {
    font-family: var(--font-meta);
    font-size: var(--type-meta-size);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .brief__row dd {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-16);
    line-height: var(--leading-24);
    color: var(--text-primary);
  }

  .brief__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-px-8);
  }

  /* Mobile and tablet centre the pair; desktop restores the left-aligned row
   * below, where the column is wide enough for it to read as one. This is the
   * case-study surface only — the homepage card owns its own actions rule. */
  .brief__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-px-12);
    margin: 0;
    padding-bottom: var(--space-px-24);
  }

  /* On mobile both actions fill the column — a narrow primary above a
   * full-width secondary inverts the emphasis. :global() for the source
   * control because it is scoped to its own component; mobile-first, so the
   * 768px block resets both to their natural widths. */
  .brief__actions .button,
  .brief__actions :global(.source-button) {
    width: 100%;
  }

  .case__body {
    max-width: var(--content-copy);
    margin: 0 auto;
  }

  .case__body :global(p) {
    margin: 0 0 var(--space-px-24);
    font-family: var(--font-body);
    font-size: var(--type-body-size);
    line-height: var(--type-body-leading);
    color: var(--text-primary);
  }

  .case__body :global(h2) {
    margin: var(--space-px-40) 0 var(--space-px-16);
    font-family: var(--font-display);
    font-size: var(--text-28);
    font-weight: var(--font-weight-regular);
    color: var(--text-heading);
  }

  .case__lead {
    font-size: var(--text-20) !important;
    color: var(--text-heading) !important;
  }

  /* ─── Long-form block types ──────────────────────────────────── */

  .case__body :global(h3) {
    margin: var(--space-px-32) 0 var(--space-px-12);
    color: var(--text-heading);
    font-family: var(--font-display);
    font-size: var(--text-20);
    font-weight: var(--font-weight-medium);
  }

  /* An aside from the source, not a warning: quiet rule, no alarm colour. */
  .case__body :global(.cs-callout) {
    margin: 0 0 var(--space-px-24);
    padding: var(--space-px-16) var(--space-px-20);
    border-left: var(--border-width-strong) solid var(--border-default);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: var(--text-16);
    line-height: var(--leading-24);
  }

  .case__body :global(.cs-quote) {
    margin: var(--space-px-32) 0;
    padding-left: var(--space-px-20);
    border-left: var(--border-width-strong) solid var(--primary);
  }

  .case__body :global(.cs-quote blockquote) {
    margin: 0;
    color: var(--text-heading);
    font-family: var(--font-display);
    font-size: var(--text-20);
    line-height: var(--leading-32);
  }

  .case__body :global(.cs-quote figcaption) {
    margin-top: var(--space-px-8);
    color: var(--text-secondary);
    font-family: var(--font-meta);
    font-size: var(--type-meta-size);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .case__body :global(.cs-list) {
    margin: 0 0 var(--space-px-24);
    padding-left: var(--space-px-20);
