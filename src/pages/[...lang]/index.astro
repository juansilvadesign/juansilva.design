---
import Footer from "../../components/Footer.astro";
import Hero from "../../components/Hero.astro";
import Marquee from "../../components/Marquee.astro";
import Projects from "../../components/Projects.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Splash from "../../components/Splash.astro";
import { heroPortrait } from "../../data/hero";
import { localeStaticPaths, t, type Locale } from "../../i18n";

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang);

// Built here rather than with `define:vars`, which `astro check` cannot see
// through (it reports the injected names as missing).
const heroPreload = `(function () {
  var stills = ${JSON.stringify(heroPortrait.stills)};
  var still = stills[document.documentElement.dataset.theme === "light" ? "light" : "dark"];
  var link = document.createElement("link");
  link.rel = "preload";
  link.as = "image";
  link.setAttribute("imagesrcset", still.srcset);
  link.setAttribute("imagesizes", ${JSON.stringify(heroPortrait.sizes)});
  link.setAttribute("fetchpriority", "high");
  document.head.appendChild(link);
})();`;
---

<BaseLayout {lang} title={copy.meta.defaultTitle} description={copy.meta.description} canonicalPath="/">
  {/*
    uiverse-10. In the head slot so it runs BEFORE the body paints — arming it
    from the body would let a frame of real page render first and then be
    covered, which reads as a stutter rather than a load screen.

    `is:inline` is load-bearing: Astro would otherwise bundle this into a
    module script, and a module is deferred by definition — it cannot run
    before first paint, which is the one thing this script exists to do.
  */}
  <Fragment slot="head">
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var KEY = "jsd:splash-seen";
        // Reading localStorage THROWS (not returns null) in some privacy
        // modes, so a failure here must mean "no splash", never a crash.
        try {
          if (localStorage.getItem(KEY)) return;
        } catch (e) {
          return;
        }
        root.dataset.splash = "on";

        var done = function () {
          if (root.dataset.splash !== "on") return;
          root.dataset.splash = "done";
          try {
            localStorage.setItem(KEY, "1");
          } catch (e) {}
        };

        // Dismissed by the real ready signal, never by a timer that decides
        // in advance how long the page "should" take. If load already fired,
        // the page was faster than this script and the splash never shows.
        if (document.readyState === "complete") done();
        else window.addEventListener("load", done, { once: true });

        // Failsafe only — an upper bound so a stalled resource cannot hold
        // the cover up indefinitely. Not the dismissal mechanism.
        setTimeout(done, 6000);
      })();
    </script>
    {/*
      The hero still for THIS visit's theme, preloaded before the stylesheets
      are requested. Both stills ship `loading="lazy"` so the hidden one is
      never fetched; this is what keeps the visible one — the LCP image — off
      the lazy path. It can only run here: the theme is known after the
      BaseLayout head script, and a body script would wait on the CSS.

      ⛔ `imagesrcset` + `imagesizes` must match the <img> exactly (both read
      `heroPortrait`), or the browser picks a different candidate and the
      preload is a second download rather than a head start.
    */}
    <script is:inline set:html={heroPreload}></script>
  </Fragment>

  <Splash {lang} />

  <main id="main-content" class="page-shell">
    <Hero {lang} />
    <Marquee {lang} />
    <Projects {lang} />
    <Footer {lang} />
  </main>
</BaseLayout>
