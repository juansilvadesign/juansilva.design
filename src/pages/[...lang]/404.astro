---
import NotFound from "../../components/NotFound.astro";
import { localeStaticPaths, type Locale } from "../../i18n";

export function getStaticPaths() {
  return localeStaticPaths({ includeDefault: false });
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<NotFound {lang} />
