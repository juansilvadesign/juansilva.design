---
import Navbar from "../components/Navbar.astro";
import SEOHead from "../components/SEOHead.astro";
import Analytics from "../components/Analytics.astro";
import { localeInfo, t, type Locale } from "../i18n";
import "../styles/clone.css";
import "../styles/shiny-text.css";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  image?: string;
  /** Travel with `image`; see the note on SEOHead's Props. */
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  noindex?: boolean;
  showNavigation?: boolean;
}

const {
  lang,
  title,
  description,
  canonicalPath,
  image,
  imageWidth,
  imageHeight,
  imageAlt,
  noindex,
  showNavigation = true,
} = Astro.props;
const copy = t(lang);
---

<!doctype html>
{/*
  `no-js` ships in the markup and is removed by the inline script below, which
  already runs before first paint for the theme. It is the only way CSS can ask
  "did scripting actually run?", and it is load-bearing for anything whose
  fallback differs from its enhanced state — today the case-study inline loops,
  which drop `autoplay` so a 31.6 MB clip is not fetched for a reader who never
  scrolls to it, and would otherwise leave a no-JS visitor staring at a video
  that never starts.

  ⛔ Removed in the same inline block as the theme, NOT from a bundled module.
  A module is deferred by definition, so the class would survive first paint and
  every enhanced element would flash its fallback before disappearing.
*/}
<html lang={localeInfo[lang].htmlLang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    {/*
      Theme must be selected before the generated stylesheets and body paint.
      `is:inline` is intentional: an Astro-bundled module is deferred, which
      would expose a frame of the fallback dark palette on a saved light visit.
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        // First statement in the file that touches the DOM: scripting is on.
        root.classList.remove("no-js");
        var KEY = "jsd:theme";
        var theme = null;

        try {
          var stored = localStorage.getItem(KEY);
          if (stored === "light" || stored === "dark") theme = stored;
        } catch (error) {
          // Privacy modes can throw on storage access. System preference is
          // still a safe, non-persistent fallback.
        }

        if (!theme) {
          try {
            theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          } catch (error) {
            theme = "dark";
          }
        }

        root.dataset.theme = theme;
      })();
    </script>
    <SEOHead
      {lang}
      {title}
      {description}
      {canonicalPath}
      {image}
      {imageWidth}
      {imageHeight}
      {imageAlt}
      {noindex}
    />
    <Analytics part="head" />
    <slot name="head" />
  </head>
  <body>
    <Analytics part="body" />
    <a class="skip-link" href="#main-content">{copy.navigation.skipToContent}</a>
    {showNavigation && <Navbar {lang} currentPath={canonicalPath} />}
    <slot />
  </body>
</html>
