---
import { locales, localeInfo, localizedPath, t, type Locale } from "../i18n";

interface Props {
  lang: Locale;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const copy = t(lang);
const alternatives = locales.filter((locale) => locale !== lang);
---

<div class="language-switch" role="group" aria-label={copy.locale.switchLabel}>
  {
    alternatives.map((locale) => (
      <a
        href={localizedPath(currentPath, locale)}
        lang={localeInfo[locale].htmlLang}
        hreflang={localeInfo[locale].hreflang}
        aria-label={`${copy.locale.switchLabel}: ${locale.toUpperCase()}`}
      >
        {/* Decorative: the anchor's aria-label already names the destination
            locale, so the flag must not repeat it in the accessibility tree. */}
        <img
          src={`/assets/icons/flags/${localeInfo[locale].flag}.svg`}
          alt=""
          width="24"
          height="24"
        />
      </a>
    ))
  }
</div>

<style>
  .language-switch {
    display: flex;
    align-items: center;
  }

  a {
    display: inline-flex;
    min-width: var(--space-px-40);
    min-height: var(--space-px-40);
    align-items: center;
    justify-content: center;
    border: var(--border-width) solid var(--border-subtle);
    border-radius: var(--radius-pill);
    background: var(--background-deep);
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      background-color var(--motion-fast) var(--ease-standard);
  }

  a:hover {
    border-color: var(--border-interactive);
    background: var(--surface-hover);
  }

  a:focus-visible {
    outline: var(--border-width-strong) solid var(--focus-ring);
    outline-offset: 2px;
  }

  img {
    width: var(--space-px-24);
    height: var(--space-px-24);
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition-duration: var(--motion-reduced);
    }
  }
</style>
