---
/**
 * uiverse-7 — `Galahhad/strong-squid-82`, ported from the supplied source.
 *
 * The original is a styled-components demo with a display:none checkbox. This
 * version remains a native checkbox so it is focusable and screen-reader
 * operable, while the decorative day/night scene stays faithful to the source.
 *
 * Two departures from the first port, both restored to the reference:
 *
 * 1. **The scene is the reference's own palette**, via `--color-scene-*` in
 *    tokens.css. It had been remapped onto theme roles — cyan-700 sky,
 *    amber-200 sun, slate moon — which kept the no-raw-hex rule and repainted
 *    the illustration. The inset rim lights also lost their 0.062em blur.
 * 2. **State comes only from `html[data-theme]`** (plus `html.no-js`), never
 *    from `:checked`. See the note on the night-state block for why the old
 *    pairing made its own light-theme overrides unreachable.
 */
import { t, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang);
---

<label
  class="theme-switch"
  data-theme-switch
  data-label-light={copy.navigation.themeSwitchToLight}
  data-label-dark={copy.navigation.themeSwitchToDark}
  title={copy.navigation.themeSwitchLabel}
>
  {/* `checked` is the dark, server-safe fallback. The blocking head script and
      the inline controller synchronise it with the persisted client choice. */}
  <input
    class="theme-switch__checkbox"
    type="checkbox"
    checked
    aria-label={copy.navigation.themeSwitchLabel}
  />
  <span class="theme-switch__container" aria-hidden="true">
    <span class="theme-switch__clouds"></span>
    <span class="theme-switch__stars-container">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 144 55" fill="none" aria-hidden="true">
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M135.831 3.00688C135.055 3.85027 134.111 4.29946 133 4.35447C134.111 4.40947 135.055 4.85867 135.831 5.71123C136.607 6.55462 136.996 7.56303 136.996 8.72727C136.996 7.95722 137.172 7.25134 137.525 6.59129C137.886 5.93124 138.372 5.39954 138.98 5.00535C139.598 4.60199 140.268 4.39114 141 4.35447C139.88 4.2903 138.936 3.85027 138.16 3.00688C137.384 2.16348 136.996 1.16425 136.996 0C136.996 1.16425 136.607 2.16348 135.831 3.00688ZM31 23.3545C32.1114 23.2995 33.0551 22.8503 33.8313 22.0069C34.6075 21.1635 34.9956 20.1642 34.9956 19C34.9956 20.1642 35.3837 21.1635 36.1599 22.0069C36.9361 22.8503 37.8798 23.2903 39 23.3545C38.2679 23.3911 37.5976 23.602 36.9802 24.0053C36.3716 24.3995 35.8864 24.9312 35.5248 25.5913C35.172 26.2513 34.9956 26.9572 34.9956 27.7273C34.9956 26.563 34.6075 25.5546 33.8313 24.7112C33.0551 23.8587 32.1114 23.4095 31 23.3545ZM0 36.3545C1.11136 36.2995 2.05513 35.8503 2.83131 35.0069C3.6075 34.1635 3.99559 33.1642 3.99559 32C3.99559 33.1642 4.38368 34.1635 5.15987 35.0069C5.93605 35.8503 6.87982 36.2903 8 36.3545C7.26792 36.3911 6.59757 36.602 5.98015 37.0053C5.37155 37.3995 4.88644 37.9312 4.52481 38.5913C4.172 39.2513 3.99559 39.9572 3.99559 40.7273C3.99559 39.563 3.6075 38.5546 2.83131 37.7112C2.05513 36.8587 1.11136 36.4095 0 36.3545ZM56.8313 24.0069C56.0551 24.8503 55.1114 25.2995 54 25.3545C55.1114 25.4095 56.0551 25.8587 56.8313 26.7112C57.6075 27.5546 57.9956 28.563 57.9956 29.7273C57.9956 28.9572 58.172 28.2513 58.5248 27.5913C58.8864 26.9312 59.3716 26.3995 59.9802 26.0053C60.5976 25.602 61.2679 25.3911 62 25.3545C60.8798 25.2903 59.9361 24.8503 59.1599 24.0069C58.3837 23.1635 57.9956 22.1642 57.9956 21C57.9956 22.1642 57.6075 23.1635 56.8313 24.0069ZM81 25.3545C82.1114 25.2995 83.0551 24.8503 83.8313 24.0069C84.6075 23.1635 84.9956 22.1642 84.9956 21C84.9956 22.1642 85.3837 23.1635 86.1599 24.0069C86.9361 24.8503 87.8798 25.2903 89 25.3545C88.2679 25.3911 87.5976 25.602 86.9802 26.0053C86.3716 26.3995 85.8864 26.9312 85.524