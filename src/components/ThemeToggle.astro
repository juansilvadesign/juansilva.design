          fill="currentColor"
        ></path>
      </svg>
    </span>
    <span class="theme-switch__circle-container">
      <span class="theme-switch__sun-moon-container">
        <span class="theme-switch__moon">
          <span class="theme-switch__spot"></span>
          <span class="theme-switch__spot"></span>
          <span class="theme-switch__spot"></span>
        </span>
      </span>
    </span>
  </span>
</label>

<script is:inline>
  (function () {
    var KEY = "jsd:theme";
    var root = document.documentElement;
    var validTheme = function (value) {
      return value === "light" || value === "dark";
    };
    var storedTheme = function () {
      try {
        var value = localStorage.getItem(KEY);
        return validTheme(value) ? value : null;
      } catch (error) {
        return null;
      }
    };
    var defaultTheme = function () {
      if (!window.matchMedia) return "dark";
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    };

    document.querySelectorAll("[data-theme-switch]").forEach(function (switcher) {
      var input = switcher.querySelector(".theme-switch__checkbox");
      if (!(input instanceof HTMLInputElement)) return;

      var labelLight = switcher.getAttribute("data-label-light") || "Switch to light theme";
      var labelDark = switcher.getAttribute("data-label-dark") || "Switch to dark theme";

      var sync = function (theme) {
        var dark = theme === "dark";
        input.checked = dark;
        var label = dark ? labelLight : labelDark;
        input.setAttribute("aria-label", label);
        switcher.setAttribute("title", label);
      };

      var apply = function (theme, persist) {
        root.dataset.theme = theme;
        sync(theme);
        if (persist) {
          try {
            localStorage.setItem(KEY, theme);
          } catch (error) {}
        }
        document.dispatchEvent(new CustomEvent("themechange", { detail: { theme: theme } }));
      };

      var initial = validTheme(root.dataset.theme) ? root.dataset.theme : storedTheme() || defaultTheme();
      apply(initial, false);

      input.addEventListener("change", function () {
        apply(input.checked ? "dark" : "light", true);
      });

      window.addEventListener("storage", function (event) {
        if (event.key && event.key !== KEY) return;
        var next = validTheme(event.newValue) ? event.newValue : defaultTheme();
        apply(next, false);
      });

      var media = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)");
      if (media && typeof media.addEventListener === "function") {
        media.addEventListener("change", function (event) {
          if (!storedTheme()) apply(event.matches ? "dark" : "light", false);
        });
      }
    });
  })();
</script>

<style>
  .theme-switch {
    --toggle-size: 12px;
    --container-width: 5.625em;
    --container-height: 2.5em;
    --container-radius: 6.25em;
    /* The reference's own scene, via the `--color-scene-*` primitives. These
       are illustration, not theme roles — see the note beside them in
       tokens.css for why they are NOT `--primary` / `--surface` / `--amber`. */
    --container-light-bg: var(--color-scene-sky-day);
    --container-night-bg: var(--color-scene-sky-night);
    --circle-container-diameter: 3.375em;
    --sun-moon-diameter: 2.125em;
    --sun-bg: var(--color-scene-sun);
    --moon-bg: var(--color-scene-moon);
    --spot-color: var(--color-scene-moon-spot);
    --stars-color: var(--color-white);
    --clouds-color: var(--color-scene-cloud);
    --back-clouds-color: var(--color-scene-cloud-back);
    --circle-container-offset: calc((var(--circle-container-diameter) - var(--container-height)) / 2 * -1);
    --theme-switch-transition: 500ms cubic-bezier(0, -0.02, 0.4, 1.25);
    --theme-switch-circle-transition: 300ms cubic-bezier(0, -0.02, 0.35, 1.17);

    position: relative;
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .theme-switch,
  .theme-switch *,
  .theme-switch *::before,
  .theme-switch *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-size: var(--toggle-size);
  }

  .theme-switch__checkbox {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    opacity: 0;
  }

  .theme-switch__container {
    position: relative;
    width: var(--container-width);
    height: var(--container-height);
    overflow: hidden;
    border-radius: var(--container-radius);
    background-color: var(--container-light-bg);
    box-shadow:
      0 -0.062em 0.062em var(--color-black-a25),
      0 0.062em 0.125em var(--color-white-a94);
    transition: var(--theme-switch-transition);
  }

  .theme-switch__container::before {
    position: absolute;
    z-index: 1;
    inset: 0;
    border-radius: inherit;
    box-shadow:
      inset 0 0.05em 0.187em var(--color-black-a25),
      inset 0 0.05em 0.187em var(--color-black-a25);
    content: "";
  }

  .theme-switch__circle-container {
    position: absolute;
    top: var(--circle-container-offset);
    left: var(--circle-container-offset);
    display: flex;
    /*
     * ⛔ These two centre the sun/moon, NOT the `margin: auto` on the knob.
     *
     * The reference centres it with `margin: auto` on the flex item, and that
     * declaration is still below — but it has never taken effect here. Astro
     * rewrites the component's `.theme-switch *` reset into
     * `.theme-switch[data-astro-cid-…] [data-astro-cid-…]`, and an attribute
     * selector carries specificity where a bare `*` carries none: (0,3,0)
     * against (0,2,0) for `.theme-switch__sun-moon-container[data-astro-cid-…]`.
     * So the reset's `margin: 0` outranks `margin: auto` no matter which is
     * written first, computed margin was `0px` on all four sides, and the knob
     * sat flush at the container's top-left corner — measured 7.5px above the
     * track's centre with its top 5.25px clipped by `overflow: hidden`.
     *
     * Flex alignment is the fix rather than a specificity duel because no reset
     * touches it, and it centres on both axes at once.
     */
    align-items: center;
    justify-content: center;
    width: var(--circle-container-diameter);
    height: var(--circle-container-diameter);
    border-radius: var(--container-radius);
    background-color: var(--color-white-a10);
    box-shadow:
      inset 0 0 0 3.375em var(--color-white-a10),
      inset 0 0 0 3.375em var(--color-white-a10),
      0 0 0 0.625em var(--color-white-a10),
      0 0 0 1.25em var(--color-white-a10);
    pointer-events: none;
    transition: var(--theme-switch-circle-transition);
  }

  .theme-switch__sun-moon-container {
    /* ⛔ `auto`, re-enabling the pointer its parent switched off. This one
       declaration is what the knob-only hover below is built on: the circle
       container is `pointer-events: none`, so the knob is the only part of it
       the pointer can reach — and :hover still matches on the ancestor. The
       port dropped it, which is why the hover had been moved onto the whole
       label. */
    pointer-events: auto;
    position: relative;
    z-index: 2;
    width: var(--sun-moon-diameter);
    height: var(--sun-moon-diameter);
    overflow: hidden;
    margin: auto;
    border-radius: var(--container-radius);
    background-color: var(--sun-bg);
    /* ⛔ The third length is the BLUR and the reference sets it to 0.062em on
       both insets. Flattening it to 0 turns the sun's soft rim light into a
       hard 1px band — the single most visible departure in the port. */
    box-shadow:
      inset 0.062em 0.062em 0.062em var(--color-scene-highlight),
      inset 0 -0.062em 0.062em var(--color-scene-sun-shade);
    filter: drop-shadow(0.062em 0.125em 0.125em var(--color-black-a25))
      drop-shadow(0 0.062em 0.125em var(--color-black-a25));
    transition: var(--theme-switch-transition);
  }

  .theme-switch__moon {
    /*
     * ⛔ `display: block`, and it is the whole moon.
     *
     * The reference's moon is a <div>; this port made every scene element a
     * <span> so the control could sit inside a <label> without invalid nesting.
     * Every other span is saved by its own positioning — the clouds, stars,
     * spots and circle container are `position: absolute`, and the sun/moon
     * container is a flex item — all of which blockify. The moon is neither. It
     * stayed an inline box, `width`/`height` do not apply to those, and it
     * measured 0x0: the night state was the SUN wearing three grey spots, and
     * had been since the port. Measured in Chrome at 1440px, moon 0x0 inside a
     * 63.75x63.75 container.
     */
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background-color: var(--moon-bg);
    /* Same blur restoration as the sun above. */
    box-shadow:
      inset 0.062em 0.062em 0.062em var(--color-scene-highlight),
      inset 0 -0.062em 0.062em var(--color-scene-moon-shade);
    transform: translateX(100%);
    transition: var(--theme-switch-transition);
  }

  .theme-switch__spot {
    position: absolute;
    top: 0.75em;
    left: 0.312em;
    width: 0.75em;
    height: 0.75em;
    border-radius: var(--container-radius);
    background-color: var(--spot-color);
    box-shadow: inset 0 0.0312em 0.062em var(--color-black-a25);
  }

  .theme-switch__spot:nth-of-type(2) {
    top: 0.937em;
    left: 1.375em;
    width: 0.375em;
    height: 0.375em;
  }

  .theme-switch__spot:nth-last-of-type(3) {
    top: 0.312em;
    left: 0.812em;
    width: 0.25em;
    height: 0.25em;
  }

  .theme-switch__clouds {
    position: absolute;
    bottom: -0.625em;
    left: 0.312em;
    width: 1.25em;
    height: 1.25em;
    border-radius: var(--container-radius);
    background-color: var(--clouds-color);
    box-shadow:
      0.937em 0.312em var(--clouds-color),
      -0.312em -0.312em var(--back-clouds-color),
      1.437em 0.375em var(--clouds-color),
      0.5em -0.125em var(--back-clouds-color),
      2.187em 0 var(--clouds-color),
      1.25em -0.062em var(--back-clouds-color),
      2.937em 0.312em var(--clouds-color),
      2em -0.312em var(--back-clouds-color),
      3.625em -0.062em var(--clouds-color),
      2.625em 0 var(--back-clouds-color),
      4.5em -0.312em var(--clouds-color),
      3.375em -0.437em var(--back-clouds-color),
      4.625em -1.75em 0 0.437em var(--clouds-color),
      4em -0.625em var(--back-clouds-color),
      4.125em -2.125em 0 0.437em var(--back-clouds-color);
    transition: var(--theme-switch-transition);
  }

  .theme-switch__stars-container {
    position: absolute;
    top: -100%;
    left: 0.312em;
    width: 2.75em;
    height: auto;
    color: var(--stars-color);
    transition: var(--theme-switch-transition);
  }

  /*
   * ── Night state ─────────────────────────────────────────────────────────
   *
   * ONE source of truth: the root attribute. What stood here paired every rule
   * with `.theme-switch__checkbox:checked + …` and then tried to override the
   * pair with `:global(html[data-theme="light"]) …`. That override could never
   * land. Astro scopes both sides, so the checked half measures (0,5,0) — two
   * classes, `:checked`, two `data-astro-cid` attributes — against (0,3,1) for
   * the root half. Higher specificity wins regardless of source order, so the
   * six light rules below the fold were dead CSS, and the switch's art was
   * decided by the checkbox alone the whole time.
   *
   * Dropping `:checked` from the visuals costs nothing: `apply()` writes
   * `root.dataset.theme` synchronously inside the change handler, so the art
   * still turns on the same tick as the click. It also removes a way for the
   * two to disagree — a checkbox the script had not yet synced used to outrank
   * the attribute the blocking head script had already written.
   *
   * ⛔ `html.no-js` is load-bearing, not belt-and-braces. With scripting off no
   * `data-theme` is ever written, `:root` keeps the dark palette, and the
   * markup's server-rendered `checked` no longer paints anything — so without
   * this selector the page would be dark and the switch would show high noon.
   * BaseLayout ships the class and removes it in its first DOM statement.
   */
  :global(html[data-theme="dark"]) .theme-switch__container,
  :global(html.no-js) .theme-switch__container {
    background-color: var(--container-night-bg);
  }

  :global(html[data-theme="dark"]) .theme-switch__circle-container,
  :global(html.no-js) .theme-switch__circle-container {
    left: calc(100% - var(--circle-container-offset) - var(--circle-container-diameter));
  }

  :global(html[data-theme="dark"]) .theme-switch__moon,
  :global(html.no-js) .theme-switch__moon {
    transform: translateX(0);
  }

  :global(html[data-theme="dark"]) .theme-switch__clouds,
  :global(html.no-js) .theme-switch__clouds {
    bottom: -4.062em;
  }

  :global(html[data-theme="dark"]) .theme-switch__stars-container,
  :global(html.no-js) .theme-switch__stars-container {
    top: 50%;
    transform: translateY(-50%);
  }

  /*
   * The knob's nudge toward its travel direction.
   *
   * ⛔ Hover on `.theme-switch__sun-moon-container`, NOT on `.theme-switch`.
   * The reference nudges only when the pointer is on the KNOB — which is why
   * `__circle-container` is `pointer-events: none` and `__sun-moon-container`
   * is `pointer-events: auto`, a pairing that otherwise reads as dead code.
   * Hovering the whole label made the knob twitch whenever the pointer crossed
   * the 44px hit area, including on its way somewhere else.
   *
   * No `:has()` is involved: `:hover` matches every ancestor of the hovered
   * element, so the knob's hover lands on the circle container that moves.
   */
  .theme-switch__circle-container:hover {
    left: calc(var(--circle-container-offset) + 0.187em);
  }

  :global(html[data-theme="dark"]) .theme-switch__circle-container:hover,
  :global(html.no-js) .theme-switch__circle-container:hover {
    left: calc(100% - var(--circle-container-offset) - var(--circle-container-diameter) - 0.187em);
  }

  .theme-switch__checkbox:focus-visible + .theme-switch__container {
    outline: var(--border-width-strong) solid var(--focus-ring);
    outline-offset: var(--space-px-4);
  }

  @media (max-width: 639px) {
    .theme-switch {
      --toggle-size: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-switch__container,
    .theme-switch__circle-container,
    .theme-switch__sun-moon-container,
    .theme-switch__moon,
    .theme-switch__clouds,
    .theme-switch__stars-container {
      transition-duration: var(--motion-reduced);
    }
  }
</style>
