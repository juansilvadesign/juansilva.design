---
/**
 * uiverse-7 — `Galahhad/strong-squid-82`, ported from the supplied source.
 *
 * The original is a styled-components demo with a display:none checkbox. This
 * version remains a native checkbox so it is focusable and screen-reader
 * operable, while the decorative day/night scene stays faithful to the source.
 * Palette values resolve through the design-system tokens; there are no raw
 * colours in this component.
 */
import { t, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang);
---

<label
  class="theme-switch"
  data-theme-switch
  data-label-light={copy.navigation.themeSwitchToLight}
  data-label-dark={copy.navigation.themeSwitchToDark}
  title={copy.navigation.themeSwitchLabel}
>
  {/* `checked` is the dark, server-safe fallback. The blocking head script and
      the inline controller synchronise it with the persisted client choice. */}
  <input
    class="theme-switch__checkbox"
    type="checkbox"
    checked
    aria-label={copy.navigation.themeSwitchLabel}
  />
  <span class="theme-switch__container" aria-hidden="true">
    <span class="theme-switch__clouds"></span>
    <span class="theme-switch__stars-container">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 144 55" fill="none" aria-hidden="true">
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M135.831 3.00688C135.055 3.85027 134.111 4.29946 133 4.35447C134.111 4.40947 135.055 4.85867 135.831 5.71123C136.607 6.55462 136.996 7.56303 136.996 8.72727C136.996 7.95722 137.172 7.25134 137.525 6.59129C137.886 5.93124 138.372 5.39954 138.98 5.00535C139.598 4.60199 140.268 4.39114 141 4.35447C139.88 4.2903 138.936 3.85027 138.16 3.00688C137.384 2.16348 136.996 1.16425 136.996 0C136.996 1.16425 136.607 2.16348 135.831 3.00688ZM31 23.3545C32.1114 23.2995 33.0551 22.8503 33.8313 22.0069C34.6075 21.1635 34.9956 20.1642 34.9956 19C34.9956 20.1642 35.3837 21.1635 36.1599 22.0069C36.9361 22.8503 37.8798 23.2903 39 23.3545C38.2679 23.3911 37.5976 23.602 36.9802 24.0053C36.3716 24.3995 35.8864 24.9312 35.5248 25.5913C35.172 26.2513 34.9956 26.9572 34.9956 27.7273C34.9956 26.563 34.6075 25.5546 33.8313 24.7112C33.0551 23.8587 32.1114 23.4095 31 23.3545ZM0 36.3545C1.11136 36.2995 2.05513 35.8503 2.83131 35.0069C3.6075 34.1635 3.99559 33.1642 3.99559 32C3.99559 33.1642 4.38368 34.1635 5.15987 35.0069C5.93605 35.8503 6.87982 36.2903 8 36.3545C7.26792 36.3911 6.59757 36.602 5.98015 37.0053C5.37155 37.3995 4.88644 37.9312 4.52481 38.5913C4.172 39.2513 3.99559 39.9572 3.99559 40.7273C3.99559 39.563 3.6075 38.5546 2.83131 37.7112C2.05513 36.8587 1.11136 36.4095 0 36.3545ZM56.8313 24.0069C56.0551 24.8503 55.1114 25.2995 54 25.3545C55.1114 25.4095 56.0551 25.8587 56.8313 26.7112C57.6075 27.5546 57.9956 28.563 57.9956 29.7273C57.9956 28.9572 58.172 28.2513 58.5248 27.5913C58.8864 26.9312 59.3716 26.3995 59.9802 26.0053C60.5976 25.602 61.2679 25.3911 62 25.3545C60.8798 25.2903 59.9361 24.8503 59.1599 24.0069C58.3837 23.1635 57.9956 22.1642 57.9956 21C57.9956 22.1642 57.6075 23.1635 56.8313 24.0069ZM81 25.3545C82.1114 25.2995 83.0551 24.8503 83.8313 24.0069C84.6075 23.1635 84.9956 22.1642 84.9956 21C84.9956 22.1642 85.3837 23.1635 86.1599 24.0069C86.9361 24.8503 87.8798 25.2903 89 25.3545C88.2679 25.3911 87.5976 25.602 86.9802 26.0053C86.3716 26.3995 85.8864 26.9312 85.5248 27.5913C85.172 28.2513 84.9956 28.9572 84.9956 29.7273C84.9956 28.563 84.6075 27.5546 83.8313 26.7112C83.0551 25.8587 82.1114 25.4095 81 25.3545ZM136 36.3545C137.111 36.2995 138.055 35.8503 138.831 35.0069C139.607 34.1635 139.996 33.1642 139.996 32C139.996 33.1642 140.384 34.1635 141.16 35.0069C141.936 35.8503 142.88 36.2903 144 36.3545C143.268 36.3911 142.598 36.602 141.98 37.0053C141.372 37.3995 140.886 37.9312 140.525 38.5913C140.172 39.2513 139.996 39.9572 139.996 40.7273C139.996 39.563 139.607 38.5546 138.831 37.7112C138.055 36.8587 137.111 36.4095 136 36.3545ZM101.831 49.0069C101.055 49.8503 100.111 50.2995 99 50.3545C100.111 50.4095 101.055 50.8587 101.831 51.7112C102.607 52.5546 102.996 53.563 102.996 54.7273C102.996 53.9572 103.172 53.2513 103.525 52.5913C103.886 51.9312 104.372 51.3995 104.98 51.0053C105.598 50.602 106.268 50.3911 107 50.3545C105.88 50.2903 104.936 49.8503 104.16 49.0069C103.384 48.1635 102.996 47.1642 102.996 46C102.996 47.1642 102.607 48.1635 101.831 49.0069Z"
          fill="currentColor"
        ></path>
      </svg>
    </span>
    <span class="theme-switch__circle-container">
      <span class="theme-switch__sun-moon-container">
        <span class="theme-switch__moon">
          <span class="theme-switch__spot"></span>
          <span class="theme-switch__spot"></span>
          <span class="theme-switch__spot"></span>
        </span>
      </span>
    </span>
  </span>
</label>

<script is:inline>
  (function () {
    var KEY = "jsd:theme";
    var root = document.documentElement;
    var validTheme = function (value) {
      return value === "light" || value === "dark";
    };
    var storedTheme = function () {
      try {
        var value = localStorage.getItem(KEY);
        return validTheme(value) ? value : null;
      } catch (error) {
        return null;
      }
    };
    var defaultTheme = function () {
      if (!window.matchMedia) return "dark";
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    };

    document.querySelectorAll("[data-theme-switch]").forEach(function (switcher) {
      var input = switcher.querySelector(".theme-switch__checkbox");
      if (!(input instanceof HTMLInputElement)) return;

      var labelLight = switcher.getAttribute("data-label-light") || "Switch to light theme";
      var labelDark = switcher.getAttribute("data-label-dark") || "Switch to dark theme";

      var sync = function (theme) {
        var dark = theme === "dark";
        input.checked = dark;
        var label = dark ? labelLight : labelDark;
        input.setAttribute("aria-label", label);
        switcher.setAttribute("title", label);
      };

      var apply = function (theme, persist) {
        root.dataset.theme = theme;
        sync(theme);
        if (persist) {
          try {
            localStorage.setItem(KEY, theme);
          } catch (error) {}
        }
        document.dispatchEvent(new CustomEvent("themechange", { detail: { theme: theme } }));
      };

      var initial = validTheme(root.dataset.theme) ? root.dataset.theme : storedTheme() || defaultTheme();
      apply(initial, false);

      input.addEventListener("change", function () {
        apply(input.checked ? "dark" : "light", true);
      });

      window.addEventListener("storage", function (event) {
        if (event.key && event.key !== KEY) return;
        var next = validTheme(event.newValue) ? event.newValue : defaultTheme();
        apply(next, false);
      });

      var media = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)");
      if (media && typeof media.addEventListener === "function") {
        media.addEventListener("change", function (event) {
          if (!storedTheme()) apply(event.matches ? "dark" : "light", false);
        });
      }
    });
  })();
</script>

<style>
  .theme-switch {
    --toggle-size: 12px;
    --container-width: 5.625em;
    --container-height: 2.5em;
    --container-radius: 6.25em;
    --container-light-bg: var(--color-cyan-700);
    --container-night-bg: var(--background-deep);
    --circle-container-diameter: 3.375em;
    --sun-moon-diameter: 2.125em;
    --sun-bg: var(--color-amber-200);
    --moon-bg: var(--color-slate-200);
    --spot-color: var(--color-slate-500);
    --stars-color: var(--color-white);
    --clouds-color: var(--color-slate-50);
    --back-clouds-color: var(--color-blue-100);
    --circle-container-offset: calc((var(--circle-container-diameter) - var(--container-height)) / 2 * -1);
    --theme-switch-transition: 500ms cubic-bezier(0, -0.02, 0.4, 1.25);
    --theme-switch-circle-transition: 300ms cubic-bezier(0, -0.02, 0.35, 1.17);

    position: relative;
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .theme-switch,
  .theme-switch *,
  .theme-switch *::before,
  .theme-switch *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-size: var(--toggle-size);
  }

  .theme-switch__checkbox {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    opacity: 0;
  }

  .theme-switch__container {
    position: relative;
    width: var(--container-width);
    height: var(--container-height);
    overflow: hidden;
    border-radius: var(--container-radius);
    background-color: var(--container-light-bg);
    box-shadow:
      0 -0.062em 0.062em var(--color-black-a25),
      0 0.062em 0.125em var(--color-white-a94);
    transition: var(--theme-switch-transition);
  }

  .theme-switch__container::before {
    position: absolute;
    z-index: 1;
    inset: 0;
    border-radius: inherit;
    box-shadow:
      inset 0 0.05em 0.187em var(--color-black-a25),
      inset 0 0.05em 0.187em var(--color-black-a25);
    content: "";
  }

  .theme-switch__circle-container {
    position: absolute;
    top: var(--circle-container-offset);
    left: var(--circle-container-offset);
    display: flex;
    width: var(--circle-container-diameter);
    height: var(--circle-container-diameter);
    border-radius: var(--container-radius);
    background-color: var(--color-white-a10);
    box-shadow:
      inset 0 0 0 3.375em var(--color-white-a10),
      inset 0 0 0 3.375em var(--color-white-a10),
      0 0 0 0.625em var(--color-white-a10),
      0 0 0 1.25em var(--color-white-a10);
    pointer-events: none;
    transition: var(--theme-switch-circle-transition);
  }

  .theme-switch__sun-moon-container {
    position: relative;
    z-index: 2;
    width: var(--sun-moon-diameter);
    height: var(--sun-moon-diameter);
    overflow: hidden;
    margin: auto;
    border-radius: var(--container-radius);
    background-color: var(--sun-bg);
    box-shadow:
      inset 0.062em 0.062em 0 var(--color-white-a61),
      inset 0 -0.062em 0 var(--color-amber-800);
    filter: drop-shadow(0.062em 0.125em 0.125em var(--color-black-a25))
      drop-shadow(0 0.062em 0.125em var(--color-black-a25));
    transition: var(--theme-switch-transition);
  }

  .theme-switch__moon {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background-color: var(--moon-bg);
    box-shadow:
      inset 0.062em 0.062em 0 var(--color-white-a61),
      inset 0 -0.062em 0 var(--color-neutral-500);
    transform: translateX(100%);
    transition: var(--theme-switch-transition);
  }

  .theme-switch__spot {
    position: absolute;
    top: 0.75em;
    left: 0.312em;
    width: 0.75em;
    height: 0.75em;
    border-radius: var(--container-radius);
    background-color: var(--spot-color);
    box-shadow: inset 0 0.0312em 0.062em var(--color-black-a25);
  }

  .theme-switch__spot:nth-of-type(2) {
    top: 0.937em;
    left: 1.375em;
    width: 0.375em;
    height: 0.375em;
  }

  .theme-switch__spot:nth-last-of-type(3) {
    top: 0.312em;
    left: 0.812em;
    width: 0.25em;
    height: 0.25em;
  }

  .theme-switch__clouds {
    position: absolute;
    bottom: -0.625em;
    left: 0.312em;
    width: 1.25em;
    height: 1.25em;
    border-radius: var(--container-radius);
    background-color: var(--clouds-color);
    box-shadow:
      0.937em 0.312em var(--clouds-color),
      -0.312em -0.312em var(--back-clouds-color),
      1.437em 0.375em var(--clouds-color),
      0.5em -0.125em var(--back-clouds-color),
      2.187em 0 var(--clouds-color),
      1.25em -0.062em var(--back-clouds-color),
      2.937em 0.312em var(--clouds-color),
      2em -0.312em var(--back-clouds-color),
      3.625em -0.062em var(--clouds-color),
      2.625em 0 var(--back-clouds-color),
      4.5em -0.312em var(--clouds-color),
      3.375em -0.437em var(--back-clouds-color),
      4.625em -1.75em 0 0.437em var(--clouds-color),
      4em -0.625em var(--back-clouds-color),
      4.125em -2.125em 0 0.437em var(--back-clouds-color);
    transition: var(--theme-switch-transition);
  }

  .theme-switch__stars-container {
    position: absolute;
    top: -100%;
    left: 0.312em;
    width: 2.75em;
    height: auto;
    color: var(--stars-color);
    transition: var(--theme-switch-transition);
  }

  /* Input state gives instant click feedback. The root selectors make the
   * art correct as soon as the blocking head script selects a saved theme. */
  .theme-switch__checkbox:checked + .theme-switch__container,
  :global(html[data-theme="dark"]) .theme-switch__container {
    background-color: var(--container-night-bg);
  }

  .theme-switch__checkbox:checked + .theme-switch__container .theme-switch__circle-container,
  :global(html[data-theme="dark"]) .theme-switch .theme-switch__circle-container {
    left: calc(100% - var(--circle-container-offset) - var(--circle-container-diameter));
  }

  .theme-switch__checkbox:checked + .theme-switch__container .theme-switch__moon,
  :global(html[data-theme="dark"]) .theme-switch .theme-switch__moon {
    transform: translateX(0);
  }

  .theme-switch__checkbox:checked + .theme-switch__container .theme-switch__clouds,
  :global(html[data-theme="dark"]) .theme-switch .theme-switch__clouds {
    bottom: -4.062em;
  }

  .theme-switch__checkbox:checked + .theme-switch__container .theme-switch__stars-container,
  :global(html[data-theme="dark"]) .theme-switch .theme-switch__stars-container {
    top: 50%;
    transform: translateY(-50%);
  }

  .theme-switch:hover .theme-switch__circle-container {
    left: calc(var(--circle-container-offset) + 0.187em);
  }

  .theme-switch:hover .theme-switch__checkbox:checked + .theme-switch__container .theme-switch__circle-container,
  :global(html[data-theme="dark"]) .theme-switch:hover .theme-switch__circle-container {
    left: calc(100% - var(--circle-container-offset) - var(--circle-container-diameter) - 0.187em);
  }

  /* A server-rendered checked input is the dark fallback. On a saved light
   * visit, the root attribute wins even in the small gap before body JS syncs
   * the checkbox property. */
  :global(html[data-theme="light"]) .theme-switch__container {
    background-color: var(--container-light-bg);
  }

  :global(html[data-theme="light"]) .theme-switch .theme-switch__circle-container {
    left: var(--circle-container-offset);
  }

  :global(html[data-theme="light"]) .theme-switch:hover .theme-switch__circle-container {
    left: calc(var(--circle-container-offset) + 0.187em);
  }

  :global(html[data-theme="light"]) .theme-switch .theme-switch__moon {
    transform: translateX(100%);
  }

  :global(html[data-theme="light"]) .theme-switch .theme-switch__clouds {
    bottom: -0.625em;
  }

  :global(html[data-theme="light"]) .theme-switch .theme-switch__stars-container {
    top: -100%;
    transform: none;
  }

  .theme-switch__checkbox:focus-visible + .theme-switch__container {
    outline: var(--border-width-strong) solid var(--focus-ring);
    outline-offset: var(--space-px-4);
  }

  @media (max-width: 639px) {
    .theme-switch {
      --toggle-size: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-switch__container,
    .theme-switch__circle-container,
    .theme-switch__sun-moon-container,
    .theme-switch__moon,
    .theme-switch__clouds,
    .theme-switch__stars-container {
      transition-duration: var(--motion-reduced);
    }
  }
</style>
