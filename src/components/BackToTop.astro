---
/**
 * uiverse-5 — "Back to top" on the 100 case-study pages.
 *
 * ⛔ CSS only, by design. K0.5 keeps the case studies island-free, and this is
 * the reason the control is an `<a href="#main-content">` rather than the
 * note's `<button>`: an anchor scrolls with no script at all, and it reuses the
 * anchor the skip-link already relies on instead of planting a second `#top`.
 *
 * The reveal is a scroll-progress animation, so it too costs no JS. Browsers
 * without `animation-timeline` fall through the `@supports` and simply keep the
 * control visible — the fallback is the useful state, never a dead affordance.
 *
 * Ported from the binder note with the raw values re-mapped onto tokens (K0.4):
 * `rgb(20,20,20)` → `--surface`, `rgb(181,160,255)` → `--primary`, and the
 * hover foreground → `--background`, which is what keeps the expanded pill
 * legible: white-on-cyan measures 1.96:1, near-black-on-cyan measures 9.66:1.
 */
import { t, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang);
const label = copy.navigation.backToTop;
---

<a class="btt" href="#main-content" aria-label={label}>
  {/*
    Lucide `arrow-big-up` (Juan, 2026-09-06), verbatim from the upstream icon —
    24×24, `fill="none"`, 2px stroke, round caps and joins, which is the same
    idiom as the site's Untitled UI set, so it sits beside them without
    retuning. Lucide is ISC: no attribution clause, unlike the Font Awesome
    glyph the binder note shipped (CC BY) whose source is gone.

    ⛔ Do not "simplify" the arcs out of this path. The `a1 1 0 0 0` segments
    are the rounded corners of the arrow's own outline; flattening them to
    straight joins is a different icon, not a tidier one.
  */}
  <svg
    class="btt__icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M9 19a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-6a1 1 0 0 1 1-1h3.293a.707.707 0 0 0 .5-1.207l-7.086-7.086a1 1 0 0 0-1.414 0l-7.086 7.086a.707.707 0 0 0 .5 1.207H8a1 1 0 0 1 1 1z"
    ></path>
  </svg>
  {/* The anchor is already named by `aria-label`; this is the same word made
      visible, so it is hidden from assistive tech to avoid announcing twice. */}
  <span class="btt__label" aria-hidden="true">{label}</span>
</a>

<style>
  .btt {
    position: fixed;
    right: var(--space-px-24);
    bottom: var(--space-px-24);
    /* Under the navbar: this scrolls away from it, and a control that could
       cover primary navigation is the wrong trade. */
    z-index: var(--z-content);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 50px clears the 44px minimum tap target on its own (Rung 6). */
    width: 50px;
    height: 50px;
    padding: 0;
    border: none;
    border-radius: var(--radius-pill);
    background-color: var(--surface);
    box-shadow: 0 0 0 4px var(--color-cyan-a12);
    color: var(--text-primary);
    text-decoration: none;
    overflow: hidden;
    cursor: pointer;
    transition:
      width var(--motion-base) ease,
      background-color var(--motion-base) ease,
      color var(--motion-base) ease,
      box-shadow var(--motion-base) ease;
  }

  .btt__icon {
    /*
      18px, not the note's 12px. Its glyph was a solid fill, which reads at any
      size; this one is a 2px stroke on a 24 viewBox, so the rendered weight is
      2 × (size / 24) — 1.0px at 12px, which goes spindly against the pill's
      text. 18px puts it at 1.5px, matching the other Untitled UI icons.
    */
    width: 18px;
    height: 18px;
    flex: none;
    /* Stroked now, so the fill would only paint the arrow's interior. The
       colour still travels via currentColor for the hover inversion. */
    fill: none;
    stroke: currentColor;
    transition: transform var(--motion-base) ease;
  }

  /*
    ⛔ ABSOLUTE, so the label takes NO layout space at rest.

    This was a real defect, not a nicety. In flow, the label kept its full
    width even at `opacity: 0` — 75px of it — so the flex line needed
    18 + 8 + 75 = 101px inside a 50px circle. `justify-content: center` splits
    that 51px overflow evenly, which pushed the icon 25.5px LEFT of the box,
    and `overflow: hidden` then clipped it away completely: measured at
    icon.left 1180 against button.left 1206, fully outside, 42px off centre.
    **The resting button was an empty circle.**

    The note avoided this with `font-size: 0`, which I replaced on the grounds
    that animating font-size relayouts text per frame. That reasoning holds —
    the mistake was dropping its layout effect without replacing it. Taking the
    label out of flow keeps both properties: nothing to relayout, and no width
    stealing the icon's centre.
  */
  .btt__label {
    position: absolute;
    /*
      `inset: 0` + `place-items: center`, NOT `top/left: 50%` + a translate.
      Both centre the box, but the translate version centred a `line-height: 1`
      box — 14px tall around a 14px font — so the glyphs sat wherever that
      font's ascent/descent left them rather than optically centred, and the
      label read low in the pill. Filling the button and centring the line box
      is the same mechanism the flex container already uses for the icon.

      It also makes the numbers legible in devtools: this reads top 0 /
      bottom 0 against the button, where the old rule showed the PRE-transform
      offsets (top 25px = 50% of 50px, bottom 11px = 50 − 25 − 14) and looked
      off-centre while the transform was in fact correcting it.
    */
    inset: 0;
    display: grid;
    place-items: center;
    /*
      ⛔ `--font-ui`, and it must be stated. `body` sets `--font-body`
      ("Lora", Georgia, serif) — the site's prose font is deliberately a serif —
      and this control sits OUTSIDE <main>, so it inherits that and rendered
      "Back to top" in Lora. Every other UI control names `--font-ui`
      explicitly (source-button.css, curved-loop.css); a button label that
      omits it does not fall back to a UI font, it falls back to the serif.
    */
    font-family: var(--font-ui);
    /* The note says 13px; the ramp has no 13. --text-14 is the nearest real
       token and reads better in the pill than --text-12. No literal fallback
       here on purpose — that would be a hard-coded value wearing a var(). */
    font-size: var(--text-14);
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transition: opacity var(--motion-base) ease;
  }

  .btt:hover,
  .btt:focus-visible {
    width: 140px;
    background-color: var(--primary);
    /* 9.66:1 against --primary. */
    color: var(--on-primary);
  }

  .btt:hover .btt__icon,
  .btt:focus-visible .btt__icon {
    transform: translateY(-200%);
  }

  .btt:hover .btt__label,
  .btt:focus-visible .btt__label {
    opacity: 1;
  }

  .btt:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  /*
    Scroll-driven reveal. Base state above is visible, so a browser without
    `animation-timeline` (Firefox and Safari at time of writing) keeps a working
    control instead of one that never appears.

    `scroll(root block)` names the document scroller explicitly — the anonymous
    `scroll()` resolves against the nearest scrollable ancestor, and this
    element is `position: fixed`, so leaving it implicit invites the wrong one.
  */
  @supports (animation-timeline: scroll()) {
    .btt {
      opacity: 0;
      visibility: hidden;
      /*
        ⛔ LONGHANDS ONLY — never the `animation` shorthand in this rule.
        lightningcss folds a neighbouring `animation-timeline` INTO the
        shorthand and emits `animation: linear both btt-reveal scroll(root)`.
        `animation-timeline` is not a component of that shorthand, so Chrome
        rejects the whole declaration: computed `animation-name` comes back
        `none`, the reveal never runs, and because this block has already set
        `opacity: 0; visibility: hidden` the control is invisible at EVERY
        scroll position. Verified in Chrome 153 — hidden at 0/400/1200/2317.
        The @supports guard cannot catch it: the condition parses fine, it is
        the declaration inside that dies.
      */
      animation-name: btt-reveal;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
      animation-range: 240px 480px;
    }
  }

  @keyframes btt-reveal {
    to {
      opacity: 1;
      visibility: visible;
    }
  }

  @media (max-width: 767px) {
    .btt {
      right: var(--space-px-16);
      bottom: var(--space-px-16);
    }
  }

  /*
    House rule: every effect carries a reduced-motion branch. The width and
    icon transitions collapse, and the scroll reveal is dropped entirely —
    a control that materialises during scrolling is exactly the kind of
    motion this preference is asking us not to run.
  */
  @media (prefers-reduced-motion: reduce) {
    .btt,
    .btt__icon,
    .btt__label {
      transition-duration: var(--motion-reduced);
    }

    .btt:hover .btt__icon,
    .btt:focus-visible .btt__icon {
      transform: none;
    }

    @supports (animation-timeline: scroll()) {
      .btt {
        opacity: 1;
        visibility: visible;
        /* Longhand here too, same reason as above. */
        animation-name: none;
      }
    }
  }
</style>
