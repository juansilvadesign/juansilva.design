---
import LanguageSwitch from "./LanguageSwitch.astro";
import ProfileLink from "./ProfileLink.astro";
import { localizedPath, t, type Locale } from "../i18n";

interface Props {
  lang: Locale;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const copy = t(lang);
const navigation = [
  { path: "/", label: copy.navigation.home, className: "navbar__item--home" },
  { path: "/projects/", label: copy.navigation.projects },
  { path: "/contact/", label: copy.navigation.contact },
];
---

<nav class="navbar" data-navbar aria-label={copy.navigation.ariaLabel}>
  <div class="navbar__inner">
    <a class="navbar__brand" href={localizedPath("/", lang)} aria-label={copy.navigation.logoAlt}>
      <img src="/assets/logo/logo-full.svg" alt="" width="143" height="32" />
    </a>

    <ul class="navbar__links">
      {
        navigation.map(({ path, label, className }) => (
          <li class={className}>
            <a
              class="navbar__link"
              href={localizedPath(path, lang)}
              aria-current={currentPath === path ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
      <li class="navbar__locale">
        <LanguageSwitch {lang} {currentPath} />
      </li>
    </ul>

    <div class="navbar__profile">
      <ProfileLink {lang} />
    </div>
  </div>
</nav>

<script>
  /**
   * The original site never scrolled, so the bar only ever had a rest state.
   * Here it switches to a compact, opaque mode once the page moves and returns
   * to rest at the very top. Read in rAF so a burst of scroll events collapses
   * into one style write per frame.
   */
  const navbar = document.querySelector<HTMLElement>("[data-navbar]");

  if (navbar) {
    const SCROLLED_FROM = 8;
    let ticking = false;

    const sync = () => {
      ticking = false;
      const scrolled = window.scrollY > SCROLLED_FROM;
      // Writing the same value would still invalidate style on some engines.
      if (scrolled !== (navbar.dataset.scrolled === "true")) {
        navbar.dataset.scrolled = String(scrolled);
      }
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(sync);
    };

    // Runs once up front: a reload or a deep link can restore a scrolled
    // position before any scroll event fires, and the bar must already match.
    sync();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<style>
  .navbar {
    position: fixed;
    z-index: var(--z-navigation);
    top: 0;
    left: 0;
    width: 100%;
    padding: var(--space-px-8) var(--space-px-16);
    border-bottom: var(--border-width-strong) solid var(--color-transparent);
    background: var(--gradient-nav-rest);
    transition:
      padding var(--motion-base) var(--ease-standard),
      background var(--motion-base) var(--ease-standard),
      border-color var(--motion-base) var(--ease-standard);
  }

  /* Scrolled: the bar stops being a transparent overlay and becomes a system
   * surface. The vertical tightening lives in the breakpoints below, because
   * only from 1024px up is there any resting slack to give back. */
  .navbar[data-scrolled="true"] {
    border-bottom-color: var(--border-interactive);
    background: var(--nav-scrolled-surface);
    backdrop-filter: blur(var(--nav-blur));
    -webkit-backdrop-filter: blur(var(--nav-blur));
  }

  .navbar__inner {
    display: grid;
    max-width: var(--container-content);
    align-items: center;
    margin: 0 auto;
    grid-template-columns: auto 1fr;
  }

  .navbar__brand {
    position: relative;
    z-index: 1;
    display: inline-flex;
    width: fit-content;
    opacity: 1;
    transition: opacity var(--motion-fast) var(--ease-standard);
  }

  .navbar__brand:hover {
    opacity: 0.8;
  }

  .navbar__brand img {
    width: auto;
    height: var(--space-px-24);
    transition: height var(--motion-base) var(--ease-standard);
  }

  .navbar__links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-px-4);
    padding: 0;
    list-style: none;
  }

  .navbar__link {
    position: relative;
    display: flex;
    padding: var(--space-px-8);
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: var(--type-label-size);
    line-height: var(--leading-32);
    transition: color var(--motion-base) var(--ease-standard);
  }

  .navbar__link::after {
    position: absolute;
    right: var(--space-px-8);
    bottom: var(--space-px-4);
    left: var(--space-px-8);
    height: var(--border-width-strong);
    border-radius: var(--radius-pill);
    background: var(--text-heading);
    content: "";
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition:
      opacity var(--motion-base) var(--ease-standard),
      transform var(--motion-base) var(--ease-standard);
  }

  .navbar__link:hover,
  .navbar__link[aria-current="page"] {
    color: var(--text-heading);
  }

  .navbar__link:hover::after,
  .navbar__link[aria-current="page"]::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .navbar__locale {
    display: flex;
    margin-left: var(--space-px-4);
  }

  .navbar__profile {
    display: none;
  }

  @media (max-width: 639px) {
    .navbar__item--home {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .navbar {
      padding-right: var(--space-px-48);
      padding-left: var(--space-px-48);
    }

    .navbar__brand img {
      height: var(--space-px-32);
    }

    .navbar__link {
      font-size: var(--type-nav-size);
    }
  }

  @media (min-width: 1024px) {
    .navbar {
      padding: var(--space-px-16) var(--space-px-56);
    }

    /* Equal specificity to the scrolled rule, so it is scoped out explicitly
     * rather than left to source order. */
    .navbar:not([data-scrolled="true"]):hover {
      border-bottom-color: var(--border-interactive);
      background: var(--gradient-nav-hover);
    }

    .navbar[data-scrolled="true"] {
      padding-top: var(--space-px-8);
      padding-bottom: var(--space-px-8);
    }

    .navbar[data-scrolled="true"] .navbar__brand img {
      height: var(--space-px-24);
    }

    .navbar__inner {
      grid-template-columns: var(--brand-column) 1fr var(--brand-column);
    }

    .navbar__links {
      justify-content: center;
      gap: var(--space-px-8);
    }

    .navbar__link {
      padding: var(--space-px-16);
    }

    .navbar__link::after {
      right: var(--space-px-16);
      bottom: var(--space-px-8);
      left: var(--space-px-16);
    }

    .navbar__profile {
      display: flex;
      width: var(--brand-column);
    }
  }

  @media (min-width: 1536px) {
    .navbar {
      padding: var(--space-px-24) var(--space-px-72);
    }

    .navbar[data-scrolled="true"] {
      padding-top: var(--space-px-8);
      padding-bottom: var(--space-px-8);
    }
  }

  /* The state change still happens; only its animation is dropped. */
  @media (prefers-reduced-motion: reduce) {
    .navbar,
    .navbar__brand img {
      transition-duration: var(--motion-reduced);
    }
  }
</style>
