---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import { t, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang);
/**
 * Sort key that tolerates every shape `dates` can now take.
 *
 * `start` is nullable for agency work where the project began before Juan did,
 * so a delivered-only record sorts on the date it actually asserts. Reading
 * `.start` directly threw on those the moment the first one was published.
 */
const sortKey = (d: { start: string | null; end: string | null }) => d.start ?? d.end ?? "";

const projects = (await getCollection("projects", ({ data }) => data.featured)).sort((a, b) =>
  sortKey(a.data.dates).localeCompare(sortKey(b.data.dates)),
);
---

<section class="projects" aria-label={copy.projects.sectionAriaLabel}>
  <div class="projects__list">
    {projects.map((project) => <ProjectCard {lang} {project} />)}
  </div>
</section>

<style>
  .projects {
    padding: var(--space-px-96) var(--space-px-24) var(--space-px-64);
  }

  .projects__list {
    display: flex;
    max-width: var(--container-content);
    flex-direction: column;
    /* The reference's 28px stack gap: cards read as a series, not as sections. */
    gap: var(--space-px-28);
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .projects {
      padding-top: var(--space-px-112);
      padding-right: var(--space-px-48);
      padding-left: var(--space-px-48);
    }
  }

  @media (min-width: 1280px) {
    .projects {
      padding-top: var(--space-px-160);
    }
  }

  @media (min-width: 1536px) {
    .projects {
      padding-right: var(--section-padding-desktop);
      padding-left: var(--section-padding-desktop);
    }
  }
</style>
