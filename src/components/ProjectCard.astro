---
import type { CollectionEntry } from "astro:content";
import StackBadge from "./StackBadge.astro";
import { localizedPath, t, type Locale } from "../i18n";
import { SIGNAL_FACETS } from "../lib/projects";
import "../styles/evidence-rail.css";

interface Props {
  lang: Locale;
  project: CollectionEntry<"projects">;
}

const { lang, project } = Astro.props;
const copy = t(lang);
const projectCopy = project.data.copy[lang];

// `evidenceLink` is optional: design-only records hold a single artifact, and
// the store now omits the second link rather than pointing it at a duplicate
// of the first or at a domain it already knows is dead.
const { evidenceLink } = project.data;
const evidenceIcon = evidenceLink?.includes("github.com")
  ? "/assets/icons/github.svg"
  : "/assets/icons/link-external-02.svg";

// The signature element carries across every surface a project appears on.
const signals = SIGNAL_FACETS.filter((s) => project.data.evidenceSignals[s]);
const caseHref = localizedPath(`/projects/${project.id}/`, lang);
const caseLabel = project.data.caseStudy
  ? copy.projects.index.caseStudy
  : copy.projects.index.caseStudySoon;
---

<div class="project-card">
  <div class="project-card__copy">
    <h2>{projectCopy.title}</h2>
    <p>{projectCopy.description}</p>
  </div>

  <div class="project-card__stacks" role="list">
    {project.data.stack.map((stack) => <StackBadge id={stack} />)}
  </div>

  {
    signals.length > 0 && (
      <ul class="rail">
        {signals.map((s) => (
          <li class="rail__item" data-signal={s}>
            <span aria-hidden="true" class="rail__dot" />
            {copy.projects.index.signalsShort[s]}
          </li>
        ))}
      </ul>
    )
  }

  <div class="project-card__actions">
    <a
      class="button project-card__primary"
      href={project.data.liveUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={projectCopy.liveLabel || copy.projects.liveProjectFallback}
    >
      <img src="/assets/icons/link-external-02.svg" alt="" width="16" height="16" />
      {projectCopy.liveLabel || copy.projects.liveProjectFallback}
    </a>

    {
      evidenceLink && (
        <a
          class="button button--secondary project-card__secondary"
          href={evidenceLink}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={projectCopy.evidenceLabel || copy.projects.evidenceFallback}
        >
          {projectCopy.evidenceLabel || copy.projects.evidenceFallback}
          <img src={evidenceIcon} alt="" width="16" height="16" />
        </a>
      )
    }
  </div>

  <a class="project-card__case" href={caseHref}>{caseLabel} →</a>
</div>

<style>
  .project-card,
  .project-card__copy {
    display: flex;
    width: 100%;
    flex-direction: column;
  }

  .project-card {
    max-width: var(--content-project);
    gap: var(--space-px-24);
  }

  .project-card__copy {
    gap: var(--space-px-8);
  }

  .project-card__stacks {
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    gap: var(--stack-gap);
  }

  .project-card__actions {
    display: flex;
    width: 100%;
    flex-direction: column;
  }

  /* The route into the case study, kept quieter than the two live actions. */
  .project-card__case {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-meta);
    font-size: var(--type-meta-size);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .project-card__case:hover {
    color: var(--primary);
  }

  .project-card__case:focus-visible {
    outline: var(--border-width-strong) solid var(--focus-ring);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__case {
      transition-duration: var(--motion-reduced);
    }
  }

  .project-card__actions .button {
    width: 100%;
  }

  .project-card__actions img {
    width: var(--space-px-16);
    height: var(--space-px-16);
  }

  @media (min-width: 768px) {
    .project-card__actions {
      flex-direction: row;
    }

    .project-card__primary {
      flex: 0 0 var(--control-primary-width);
    }

    .project-card__secondary {
      flex: 1 1 auto;
    }
  }

  @media (min-width: 1536px) {
    .project-card {
      padding-top: var(--space-px-27);
    }
  }
</style>
