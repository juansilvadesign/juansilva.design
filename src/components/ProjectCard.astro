---
import type { CollectionEntry } from "astro:content";
import SourceCodeButton from "./SourceCodeButton.astro";
import StackBadge from "./StackBadge.astro";
import { localizedPath, t, type Locale } from "../i18n";
import { PREVIEW_MOTION_TYPES, SIGNAL_FACETS, formatTimeframe, isVideoPreview, motionPreviewFor, previewFor, projectActions } from "../lib/projects";
import "../styles/evidence-rail.css";
import "../styles/action-row.css";

interface Props {
  lang: Locale;
  project: CollectionEntry<"projects">;
}

const { lang, project } = Astro.props;
const copy = t(lang);
const projectCopy = project.data.copy[lang];
const d = project.data;

// The signature element carries across every surface a project appears on.
const signals = SIGNAL_FACETS.filter((s) => d.evidenceSignals[s]);

const [primary, secondary] = projectActions({
  sourceCode: d.evidenceSignals.sourceCode,
  liveUrl: d.liveUrl,
  liveLabel: projectCopy.liveLabel,
  evidenceLink: d.evidenceLink,
  caseHref: localizedPath(`/projects/${project.id}/`, lang),
  // The SAME predicate `/projects` uses (`projects.astro` → `hasCaseStudy`),
  // deliberately reusing its two labels rather than the near-duplicate
  // `projects.caseFallback`. Those had drifted: this card promised "Read the
  // case study" for records whose `caseStudy` is null, while the index called
  // the very same record "View project". The schema makes `caseStudy` either
  // null or both locales, so this one check is complete.
  //
  // ⛔ This label now sits on the PRIMARY control, which raises the cost of
  // breaking the tie-up: `ProjectsIndex.tsx` renders the identical ternary for
  // the same record. Hard-coding one string here — "View project" on every
  // card regardless of whether a narrative exists — re-opens exactly the drift
  // the paragraph above records, and does it on the loudest button we have.
  caseLabel:
    d.caseStudy !== null ? copy.projects.index.caseStudy : copy.projects.index.caseStudySoon,
  liveFallbackLabel: copy.projects.liveProjectFallback,
  sourceLabel: copy.projects.sourceFallback,
});

// A record that asserts source code without carrying the link to it is a real
// gap in the store, not a template problem. Surface it at build time rather
// than silently rendering a fallback. This is now the only inconsistency worth
// warning about: the old check fired on every non-Figma record with no repo,
// which described most of the store rather than a defect.
if (d.evidenceSignals.sourceCode && !d.evidenceLink) {
  console.warn(
    `[projects] ${project.id}: evidenceSignals.sourceCode is true but the ` +
      `record carries no evidenceLink — second action fell back to the live site.`,
  );
}

const preview = previewFor(d, lang);
const isVideo = isVideoPreview(preview);

/**
 * The card's moving preview, where the record ships one. It sits on the still
 * until the pointer arrives, so the homepage costs three images at rest rather
 * than three videos — `preload="none"` means nothing is fetched until a hover
 * actually happens, and on a touch device nothing is fetched at all.
 *
 * Takes precedence over `isVideo`, which is the older single-source shape
 * (`price-watcher`, whose `preview` IS an .mp4). That one has no still to fall
 * back to, so it must autoplay; this one must not.
 */
const motion = motionPreviewFor(d, lang);

// The reference's chip is compact metadata, not a repeat of what sits below it:
// the stack badges already name the stack two rows down.
const timeframe = formatTimeframe(d.dates, lang, copy.projects.detail);
---

<article class="case-card">
  <div class="case-card__copy">
    {timeframe && <p class="case-card__chip">{timeframe}</p>}

    <h2 class="case-card__title">{projectCopy.title}</h2>
    <p class="case-card__body">{projectCopy.description}</p>

    <div class="case-card__stacks" role="list">
      {d.stack.map((stack) => <StackBadge id={stack} />)}
    </div>

    {
      signals.length > 0 && (
        <ul class="rail">
          {signals.map((s) => (
            <li class="rail__item" data-signal={s}>
              <span aria-hidden="true" class="rail__dot" />
              {copy.projects.index.signalsShort[s]}
            </li>
          ))}
        </ul>
      )
    }

    <div class="case-card__actions">
      {/*
        Slot one is the case study, and it is the one action on this card that
        stays on the site — so no target and no rel, unlike the sibling below.

        It carries the SAME `case-cta` class as that sibling, which is the whole
        point: the two halves of the pair run one motion, and sharing the class
        rather than copying its rules is what stops them drifting apart later.
        `--primary` only swaps the colour roles. The old box-and-arrow
        external-link glyph is gone with the behaviour it advertised — this slot
        used to hold the live URL.
      */}
      <a class="button case-cta case-cta--primary" href={primary.href}>
        <svg
          class="case-cta__arr case-cta__arr--in"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M16.1716 10.9999L10.8076 5.63589L12.2218 4.22168L20 11.9999L12.2218 19.778L10.8076 18.3638L16.1716 12.9999H4V10.9999H16.1716Z"
          ></path>
        </svg>
        <span class="case-cta__text">{primary.label}</span>
        <span class="case-cta__circle" aria-hidden="true"></span>
        <svg
          class="case-cta__arr case-cta__arr--out"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M16.1716 10.9999L10.8076 5.63589L12.2218 4.22168L20 11.9999L12.2218 19.778L10.8076 18.3638L16.1716 12.9999H4V10.9999H16.1716Z"
          ></path>
        </svg>
      </a>

      {
        secondary.kind === "source" ? (
          <SourceCodeButton {lang} href={secondary.href} slug={project.id} />
        ) : (
          <a
            class="button button--secondary case-cta"
            href={secondary.href}
            target={secondary.external ? "_blank" : undefined}
            rel={secondary.external ? "noopener noreferrer" : undefined}
          >
            <svg
              class="case-cta__arr case-cta__arr--in"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M16.1716 10.9999L10.8076 5.63589L12.2218 4.22168L20 11.9999L12.2218 19.778L10.8076 18.3638L16.1716 12.9999H4V10.9999H16.1716Z"
              ></path>
            </svg>
            <span class="case-cta__text">{secondary.label}</span>
            <span class="case-cta__circle" aria-hidden="true"></span>
            <svg
              class="case-cta__arr case-cta__arr--out"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M16.1716 10.9999L10.8076 5.63589L12.2218 4.22168L20 11.9999L12.2218 19.778L10.8076 18.3638L16.1716 12.9999H4V10.9999H16.1716Z"
              ></path>
            </svg>
          </a>
        )
      }
    </div>
  </div>

  <div class="case-card__visual">
    {
      motion ? (
        <div class="pv" data-preview-motion={String(motion.hoverStart ?? 0)}>
          {/*
            The still is a <picture>, not a bare <img>: `preview` is the JPEG
            every surface can read and `motion.poster` is the WebP this one
            prefers. Both are encoded from the same source frame — see
            `PreviewMotion` — so which one a browser picks is invisible.
          */}
          <picture>
            <source srcset={motion.poster} type="image/webp" />
            <img
              class="pv__still"
              src={preview}
              alt={projectCopy.previewAlt}
              width={motion.width}
              height={motion.height}
              loading="lazy"
              decoding="async"
            />
          </picture>
          {/*
            Decorative: the <picture> above already carries the alt text, and
            this is the same photograph in motion. Hidden from the tree and
            untabbable rather than given a second, near-duplicate label.

            The source types come from `PREVIEW_MOTION_TYPES` so this and the
            case-study hero cannot declare the same file differently. Unlike the
            case-study video BLOCKS, this WebM is VP9 *Profile 0* (4:2:0): a
            photographic device mockup has none of the UI-glyph fringing that
            bought 4:4:4 its cost there, and Profile 0 is the profile Safari
            actually plays.
          */}
          <video
            class="pv__motion"
            muted
            loop
            playsinline
            preload="none"
            poster={motion.poster}
            width={motion.width}
            height={motion.height}
            aria-hidden="true"
            tabindex="-1"
          >
            <source src={motion.webm} type={PREVIEW_MOTION_TYPES.webm} />
            <source src={motion.mp4} type={PREVIEW_MOTION_TYPES.mp4} />
          </video>
        </div>
      ) : isVideo ? (
        <video src={preview} muted loop playsinline autoplay aria-label={projectCopy.previewAlt} />
      ) : (
        <img
          src={preview}
          alt={projectCopy.previewAlt}
          width="1920"
          height="1080"
          loading="lazy"
          decoding="async"
        />
      )
    }
  </div>
</article>

{/*
  Deliberately NOT `is:inline`, unlike the theme and splash scripts. Those run
  once per page and must run before paint; this component renders once per
  featured card, and an inline script would be emitted three times. Astro hoists
  and bundles a plain <script>, so all three cards are wired by one copy of it.

  ⛔ That choice also means this file IS type-checked, which `is:inline` scripts
  are not — the identical `instanceof` guard in ThemeToggle passes only because
  nothing checks it. Bindings the guards narrow are `const` for that reason: a
  `var` loses its narrowing at every closure boundary below, and every use of
  `video` inside these handlers then reads as possibly-null.

  Everything here is an enhancement over markup that is already correct: with no
  JS at all the card shows its still, which is the same picture the video opens
  on and carries the same alt text.
*/}
<script>
  // Attached only where a pointer can genuinely hover. On a touch screen
  // `pointerenter` fires on tap, which would spend megabytes of someone's
  // mobile data on a video they cannot even see play.
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll("[data-preview-motion]").forEach((node) => {
    if (!(node instanceof HTMLElement)) return;
    const frame = node;
    const found = frame.querySelector("video");
    if (!(found instanceof HTMLVideoElement)) return;
    const video = found;

    // The card, not the media box: the pointer emphasis at >=1280px is on the
    // whole card, and a preview that only woke over the right-hand column
    // would contradict it.
    const card = frame.closest(".case-card") ?? frame;
    const start = Number(frame.dataset.previewMotion) || 0;
    let armed = false;

    const paint = () => frame.classList.add("is-playing");

    // Fade in on the first DECODED frame, not on play(). play() resolves when
    // playback begins, which can precede the first composited frame — fading
    // there shows the card's background through the crossfade.
    const reveal = () => {
      const rvfc = Reflect.get(video, "requestVideoFrameCallback");
      if (typeof rvfc === "function") rvfc.call(video, paint);
      else paint();
    };

    /*
     * ⛔ The crossfade waits for the clip to BE past its fade-in; it does not
     * trust the seek that tried to put it there.
     *
     * A seek is only honoured where the source is seekable, and that is a
     * property of the SERVER, not the file: without HTTP Range, `seekable` stays
     * [0, 0] and `currentTime = start` is silently clamped back to 0 — the
     * `seeked` event fires anyway, so nothing reports a failure. R2 answers 206
     * and seeks fine, but a card that trusted that would open on upOS's closed
     * laptop the day anything served this differently. Gating on the position
     * itself degrades to "waits a beat, then fades" instead.
     *
     * One stable listener: re-adding an identical handler is a no-op per spec,
     * so repeated hovers cannot stack them.
     */
    const tick = () => {
      if (video.currentTime >= start) {
        video.removeEventListener("timeupdate", tick);
        reveal();
      }
    };

    const revealPastFadeIn = () => {
      if (start <= 0 || video.currentTime >= start) reveal();
      else video.addEventListener("timeupdate", tick);
    };

    const go = () => {
      // Seek forward past the fade-in, once. Only ever forward: a hover
      // returning mid-clip resumes where it was rather than snapping back.
      if (start > 0 && video.readyState >= 1 && video.currentTime < start) {
        try {
          video.currentTime = start;
        } catch {
          /* A refused seek costs the wait above, not the preview. */
        }
      }
      const played = video.play();
      if (played && typeof played.then === "function") {
        played.then(revealPastFadeIn, () => {
          /* Autoplay refused even muted — the still stays, which is correct. */
        });
      } else {
        revealPastFadeIn();
      }
    };

    const enter = () => {
      if (reduce.matches) return;
      if (!armed) {
        armed = true;
        // preload="none" in the markup, so nothing was fetched until now.
        video.preload = "auto";
        video.load();
      }
      if (video.readyState >= 1) go();
      else video.addEventListener("loadedmetadata", go, { once: true });
    };

    const leave = () => {
      // Drop the pending gate too: left mid-wait, it would otherwise fire the
      // crossfade on a card the pointer had already abandoned.
      video.removeEventListener("timeupdate", tick);
      frame.classList.remove("is-playing");
      video.pause();
    };

    if (canHover.matches) {
      card.addEventListener("pointerenter", enter);
      card.addEventListener("pointerleave", leave);
    }
    // Keyboard parity, the same rule `.case-cta` follows for its own hover
    // effect: the card's two actions are focusable, so tabbing onto one wakes
    // the preview exactly as pointing at it would.
    card.addEventListener("focusin", enter);
    card.addEventListener("focusout", leave);
  });
</script>

<style>
  /* A bordered editorial container, not a shadowed dashboard widget. */
  .case-card {
    display: grid;
    overflow: hidden;
    border: var(--border-width-strong) solid var(--border-default);
    border-radius: var(--radius-case);
    background: var(--surface);
    grid-template-columns: minmax(0, 1fr);
    transition:
      transform var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-fast) var(--ease-standard);
  }

  .case-card__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-px-24);
    gap: var(--space-px-24);
  }

  .case-card__chip {
    margin: 0;
    padding: var(--space-px-6) var(--space-px-14);
    border-radius: var(--radius-pill);
    background: var(--background-deep);
    color: var(--text-secondary);
    font-family: var(--font-meta);
    font-size: var(--type-meta-size);
    line-height: var(--type-meta-leading);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-card__title {
    margin: 0;
    color: var(--text-heading);
    font-family: var(--font-display);
    font-size: var(--text-24);
    font-weight: var(--font-weight-medium);
    line-height: 1.08;
    text-wrap: balance;
  }

  .case-card__body {
    max-width: 44ch;
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: var(--type-body-mobile-size);
    line-height: var(--type-body-mobile-leading);
  }

  .case-card__stacks {
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    gap: var(--stack-gap);
  }

  .case-card__actions {
    display: flex;
    width: 100%;
    flex-direction: column;
    flex-wrap: wrap;
    gap: var(--space-px-12);
  }

  /* `.source-button` is scoped to its own component, so the parent reaches it
   * through :global() — same as the visual's img/video below. */
  .case-card__actions .button,
  .case-card__actions :global(.source-button) {
    width: 100%;
  }

  .case-card__actions img {
    width: var(--space-px-16);
    height: var(--space-px-16);
  }

  /*
   * uiverse-6 — the outlined half of the action pair, ported from the binder
   * note's `.animated-button`.
   *
   * It was written as the case-study CTA and is named for that. It no longer
   * is: the case study took the filled primary slot, and what lands here is the
   * live-site fallback — the records with a repo render `SourceCodeButton`
   * instead. The treatment is unchanged, only what stands in it.
   *
   * ⛔ K0.2: the note's own URL repeats uiverse-5's `loud-chicken-53` and
   * points at a different component entirely. Everything below is built from
   * the note's CODE, never from that link.
   *
   * K0.4: the note is built on `greenyellow` with a `#212121` inversion. Both
   * are re-mapped — the accent onto `--primary`, which the card's own hover
   * already borders in, so the button reads as part of that gesture rather
   * than a second unrelated accent. Measured 9.24:1 for the ring and label on
   * the card surface, and again for the dark label once the cyan floods.
   */

  .case-cta {
    --case-accent: var(--primary);
    --case-ink-rest: var(--primary-ink);
    --case-ink-active: var(--on-primary);
    --case-arrow-size: var(--space-px-16);
    --case-arrow-inset: var(--space-px-16);
    --case-shift: var(--space-px-12);
    --case-circle-rest: var(--space-px-20);
    --case-duration: 800ms;
    --case-ring-duration: 600ms;
    /* The note's own curve — a long, decelerating settle. Not a token: no
     * existing easing token matches it, and K0.4 governs colour, not motion. */
    --case-ease: cubic-bezier(0.23, 1, 0.32, 1);

    position: relative;
    overflow: hidden;
    /* Wide enough that the centred label never runs under either arrow.
     * The note buys the same clearance with 36px; this is the nearest token. */
    padding-inline: var(--space-px-40);
    border-radius: var(--radius-pill);
    box-shadow: 0 0 0 var(--border-width-strong) var(--case-accent);
    color: var(--case-ink-rest);
    transition:
      color var(--motion-base) var(--case-ease),
      box-shadow var(--case-ring-duration) var(--case-ease),
      border-radius var(--case-ring-duration) var(--case-ease);
  }

  /* Both arrows are decoration for a link whose label already carries the
   * meaning, so neither is exposed and neither can take the pointer. */
  .case-cta__arr {
    position: absolute;
    z-index: 2;
    top: 50%;
    width: var(--case-arrow-size);
    height: var(--case-arrow-size);
    fill: currentColor;
    pointer-events: none;
    transform: translateY(-50%);
    transition:
      left var(--case-duration) var(--case-ease),
      right var(--case-duration) var(--case-ease);
  }

  .case-cta__arr--out {
    right: var(--case-arrow-inset);
  }

  .case-cta__arr--in {
    left: -25%;
  }

  .case-cta__text {
    position: relative;
    z-index: 1;
    transform: translateX(calc(var(--case-shift) * -1));
    transition: transform var(--case-duration) var(--case-ease);
  }

  /*
   * The flood. The note fixes this at 220px, which covers ITS button and
   * nothing wider — below 768px this control is `width: 100%` and a 220px
   * circle would leave the edges unflooded. `150%` of the button's own width
   * always exceeds its diagonal at this aspect ratio, so the fill is complete
   * at every width, and `aspect-ratio` keeps it a circle rather than an
   * ellipse as it grows.
   */
  .case-cta__circle {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 50%;
    width: var(--case-circle-rest);
    aspect-ratio: 1;
    border-radius: 50%;
    opacity: 0;
    background: var(--case-accent);
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition:
      width var(--case-duration) var(--case-ease),
      opacity var(--case-duration) var(--case-ease);
  }

  /*
   * Full `:focus-visible` parity here — the opposite of uiverse-4's hero CTA,
   * and for the opposite reason. That effect HIDES its label, so a persistent
   * focus state could not carry it; this one only shifts the label 12px and
   * floods behind it, leaving it readable throughout. uiverse-3's parity rule
   * therefore applies unchanged.
   */
  .case-cta:hover,
  .case-cta:focus-visible {
    border-radius: var(--radius-control);
    background: var(--color-transparent);
    box-shadow: 0 0 0 var(--space-px-12) var(--color-transparent);
    color: var(--case-ink-active);
  }

  .case-cta:hover .case-cta__arr--out,
  .case-cta:focus-visible .case-cta__arr--out {
    right: -25%;
  }

  .case-cta:hover .case-cta__arr--in,
  .case-cta:focus-visible .case-cta__arr--in {
    left: var(--case-arrow-inset);
  }

  .case-cta:hover .case-cta__text,
  .case-cta:focus-visible .case-cta__text {
    transform: translateX(var(--case-shift));
  }

  .case-cta:hover .case-cta__circle,
  .case-cta:focus-visible .case-cta__circle {
    width: 150%;
    opacity: 1;
  }

  .case-cta:active {
    scale: 0.95;
    box-shadow: 0 0 0 var(--space-px-4) var(--case-accent);
  }

  /*
   * The primary, wearing the identical motion with the colour roles reversed.
   * Everything above still drives it — travel, easing, durations, the
   * reduced-motion opt-out — and only the four colour decisions differ:
   *
   *   secondary   rest: outlined, accent ink   hover: accent floods, ink inverts
   *   primary     rest: accent FILL, ink on it hover: SURFACE floods, ink inverts
   *
   * Selector depth is load-bearing, not habit: `action-row.css` reaches these
   * controls at `.case-card__actions .button:not(...)`, so a bare
   * `.case-cta--primary` would lose to it on specificity even though it opts
   * out there. Two classes under the row wins.
   */
  .case-card__actions .case-cta--primary {
    --case-ink-rest: var(--on-primary);
    --case-ink-active: var(--primary-ink);

    border-color: var(--primary);
    background: var(--primary);
    color: var(--case-ink-rest);
  }

  /* The disc is the inverse of the secondary's: surface arriving over accent. */
  .case-card__actions .case-cta--primary .case-cta__circle {
    background: var(--surface);
  }

  /*
   * ⛔ The fill has to SURVIVE the hover. The shared rule clears the background
   * so the secondary's transparent rest state stays transparent while its disc
   * grows — but here the background IS the rest state, and clearing it would
   * show the card straight through the corners for the whole 800ms the disc
   * takes to cover them.
   */
  .case-card__actions .case-cta--primary:hover,
  .case-card__actions .case-cta--primary:focus-visible {
    background: var(--primary);
    color: var(--case-ink-active);
  }

  /*
   * Stacked, the media leads. The copy stays first in the DOM — it carries the
   * heading and both actions, so it is what a screen reader and a crawler
   * should meet first — and only the PAINT order is reversed. A card whose
   * picture arrives after three paragraphs and two buttons is a card whose
   * picture is never seen on a phone.
   *
   * Reset explicitly at the two-column breakpoint below; `order` does not
   * unset itself when the grid changes shape.
   */
  .case-card__visual {
    display: flex;
    overflow: hidden;
    min-height: var(--space-px-252);
    order: -1;
    background: var(--background-deep);
  }

  .case-card__visual :global(img),
  .case-card__visual :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  /*
   * The hover preview. Two layers in one frame, so the swap changes which
   * element paints and never the geometry — the <video> carries the record's
   * own width/height, identical to the still's, and both are `cover`.
   */
  .pv {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /*
   * The X anchor, and only the X — the vertical stays where the card default
   * put it.
   *
   * Measured: at 1440px the media column is 570x599, so a 16:9 frame under
   * `cover` keeps ~53% of its width. Anchored left, that cut the upOS laptop
   * clean in half. Sampling the crop at 0 / 40 / 50 / 60% put the whole screen
   * in frame from 40% on and centred it at 50%.
   *
   * ⛔ Scoped to `.pv`, never to the card default. syd and psiativa ship flat
