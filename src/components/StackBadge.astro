---
import { STACK_ICONS, type StackId } from "../lib/stack";

interface Props {
  id: StackId;
}

const { id } = Astro.props;

/* Icons come from `lib/stack.ts` — the /projects filter chips are a React
   island and render the same marks, so the paths cannot live in here. */
const stackNames = {
  typescript: "TypeScript",
  javascript: "JavaScript",
  tailwind: "Tailwind",
  figma: "Figma",
  python: "Python",
  opensource: "Open Source",
} as const satisfies Record<StackId, string>;

const stack = { name: stackNames[id], icon: STACK_ICONS[id] };
---

<span class:list={["technology", `technology--${id}`]} role="listitem">
  <span class="technology__inner">
    <img src={stack.icon} alt="" width="16" height="16" aria-hidden="true" />
    <span>{stack.name}</span>
  </span>
</span>

<style>
  .technology {
    display: inline-flex;
    padding: var(--space-px-1);
    border-radius: var(--radius-pill);
    background: var(--stack-border-background, var(--border-default));
    color: var(--stack-foreground, var(--text-primary));
    font-family: var(--font-ui);
    font-size: var(--type-label-size);
    line-height: var(--type-label-leading);
  }

  .technology__inner {
    display: inline-flex;
    align-items: center;
    gap: var(--space-px-4);
    padding: var(--space-px-4) var(--space-px-12) var(--space-px-4) var(--space-px-10);
    border-radius: var(--radius-pill);
    background: var(--stack-background, var(--surface));
  }

  img {
    width: var(--space-px-16);
    height: var(--space-px-16);
  }

  /*
   * ⛔ Roles, not primitives. Each of these named `--color-blue-950`,
   * `--color-amber-950`, `--gradient-stack-python` and friends directly, so
   * every pill kept its dark-canvas navy / amber / near-black fill on the white
   * page — a row of dark chips on a light card. The three roles per stack are
   * defined in BOTH theme layers of `design-system/tokens.css`; the dark values
   * there are byte-for-byte what used to be written here.
   */
  .technology--typescript {
    --stack-background: var(--stack-typescript-fill);
    --stack-border-background: var(--stack-typescript-border);
    --stack-foreground: var(--stack-typescript-ink);
  }

  .technology--javascript {
    --stack-background: var(--stack-javascript-fill);
    --stack-border-background: var(--stack-javascript-border);
    --stack-foreground: var(--stack-javascript-ink);
  }

  .technology--tailwind {
    --stack-background: var(--stack-tailwind-fill);
    --stack-border-background: var(--stack-tailwind-border);
    --stack-foreground: var(--stack-tailwind-ink);
  }

  .technology--figma {
    --stack-background: var(--stack-figma-fill);
    --stack-border-background: var(--stack-figma-border);
    --stack-foreground: var(--stack-figma-ink);
  }

  .technology--python {
    --stack-background: var(--stack-python-fill);
    --stack-border-background: var(--stack-python-border);
    --stack-foreground: var(--stack-python-ink);
  }

  .technology--opensource {
    --stack-background: var(--stack-opensource-fill);
    --stack-border-background: var(--stack-opensource-border);
    --stack-foreground: var(--stack-opensource-ink);
  }
</style>
