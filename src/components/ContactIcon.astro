---
import type { ContactIconName } from "../types/contact";

interface Props {
  name: ContactIconName;
}

const { name } = Astro.props;
const isFilled =
  name === "whatsapp" ||
  name === "linkedin" ||
  name === "linkedin-outlined" ||
  name === "github";

/*
 * Every mark here is drawn on a 24 grid except `linkedin-outlined`, which is
 * the verbatim path from `public/assets/icons/linkedin.svg` — the mark the
 * footer's own social row already uses — and that file is authored at 33x32.
 * Re-drawing it onto 24 would make it a THIRD LinkedIn path to keep in sync;
 * carrying its viewBox instead keeps it byte-identical to the asset, so the
 * two footer columns cannot drift apart.
 */
const viewBox = name === "linkedin-outlined" ? "0 0 33 32" : "0 0 24 24";
---

<svg
  aria-hidden="true"
  viewBox={viewBox}
  fill={isFilled ? "currentColor" : "none"}
  stroke={isFilled ? undefined : "currentColor"}
  stroke-width={isFilled ? undefined : 2}
  stroke-linecap={isFilled ? undefined : "round"}
  stroke-linejoin={isFilled ? undefined : "round"}
>
  {name === "contact" && (
    <>
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
      <circle cx="9" cy="7" r="4" />
      <path d="M19 8v6M22 11h-6" />
    </>
  )}
  {name === "phone" && (
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.56 2.81.69A2 2 0 0 1 22 16.92Z" />
  )}
  {name === "whatsapp" && (
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.13c-.24.68-1.42 1.32-1.95 1.36-.5.05-.5.4-3.15-.66-2.65-1.06-4.3-3.75-4.43-3.92-.13-.17-1.06-1.4-1.06-2.67 0-1.27.67-1.9.9-2.16.24-.26.52-.32.7-.32.17 0 .35 0 .5.01.16.01.38-.06.6.46.23.53.77 1.83.84 1.96.07.13.11.29.02.46-.09.17-.13.29-.26.44-.13.15-.28.34-.4.46-.13.13-.27.28-.11.55.16.26.7 1.16 1.51 1.88 1.04.93 1.92 1.21 2.19 1.34.26.13.42.11.57-.07.16-.17.66-.77.83-1.03.17-.26.35-.22.59-.13.24.09 1.53.72 1.79.85.26.13.43.19.5.3.06.11.06.64-.18 1.32Z" />
  )}
  {name === "linkedin" && (
    <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
  )}
  {/*
    The bare wordmark — no container square — which is what tells it apart from
    `linkedin` above, the boxed glyph the /card page's tiles use. Path copied
    verbatim from `public/assets/icons/linkedin.svg`, minus that file's baked
    `fill="#94979C"`: a dark-canvas neutral that measures 1.5:1 on the light
    theme's page. Here it inherits `currentColor` from the row's label, the
    same correction the footer's version chevron and the hero's external-link
    glyph each already carry.
  */}
  {name === "linkedin-outlined" && (
    <path d="M2.5 5.63636C2.5 4.72725 2.81532 3.97725 3.44595 3.38636C4.07657 2.79545 4.89641 2.5 5.90541 2.5C6.89641 2.5 7.69819 2.79089 8.31081 3.37273C8.94143 3.97273 9.25676 4.75453 9.25676 5.71818C9.25676 6.59091 8.95046 7.31816 8.33784 7.9C7.70722 8.5 6.87838 8.8 5.85135 8.8H5.82432C4.83332 8.8 4.03154 8.5 3.41892 7.9C2.8063 7.3 2.5 6.54545 2.5 5.63636ZM2.85135 29.5V11.2818H8.85135V29.5H2.85135ZM12.1757 29.5H18.1757V19.3273C18.1757 18.6909 18.2478 18.2 18.3919 17.8545C18.6441 17.2364 19.027 16.7136 19.5405 16.2864C20.0541 15.8591 20.6982 15.6455 21.473 15.6455C23.491 15.6455 24.5 17.0182 24.5 19.7636V29.5H30.5V19.0545C30.5 16.3636 29.8694 14.3227 28.6081 12.9318C27.3468 11.5409 25.6802 10.8455 23.6081 10.8455C21.2838 10.8455 19.473 11.8545 18.1757 13.8727V13.9273H18.1486L18.1757 13.8727V11.2818H12.1757C12.2117 11.8636 12.2297 13.6727 12.2297 16.7091C12.2297 19.7454 12.2117 24.0091 12.1757 29.5Z" />
  )}
  {name === "website" && (
    <>
      <circle cx="12" cy="12" r="10" />
      <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z" />
    </>
  )}
  {name === "email" && (
    <>
      <rect x="2" y="4" width="20" height="16" rx="2" />
      <path d="m22 7-10 6L2 7" />
    </>
  )}
  {name === "github" && (
    <path d="M12 .5A12 12 0 0 0 8.2 23.88c.6.11.82-.26.82-.58v-2.1c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23A11.5 11.5 0 0 1 12 6.42c1.02 0 2.04.14 3 .4 2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.17c0 .32.22.69.83.57A12 12 0 0 0 12 .5Z" />
  )}
</svg>

<style>
  svg {
    display: block;
    width: var(--space-px-24);
    height: var(--space-px-24);
  }
</style>
