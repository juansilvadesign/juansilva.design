---
import { contact } from "../data/contact";
import { t, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang).card;
---

<header class="profile-header">
  <div class="profile-header__avatar-wrap">
    {/* Theme-paired like the hero it is cropped from: black suit on the dark
        card, white suit on the light one (`[data-theme-art]`, clone.css).
        Both eager — at ~20 KB the second fetch costs less than a lazy load's
        wait on the one image above the fold. */}
    {(["dark", "light"] as const).map((theme) => (
      <img
        class="profile-header__avatar"
        src={contact.avatar[theme]}
        alt={copy.portraitAlt}
        width="128"
        height="128"
        loading="eager"
        decoding="async"
        data-theme-art={theme}
      />
    ))}
  </div>
  <h1>{contact.name.display}</h1>
  <p class="profile-header__role">{contact.title}</p>
  <p class="profile-header__tagline">{contact.tagline}</p>
</header>

<style>
  .profile-header {
    width: 100%;
    text-align: center;
  }

  .profile-header__avatar-wrap {
    width: var(--space-px-128);
    height: var(--space-px-128);
    padding: var(--space-px-4);
    border: var(--border-width) solid var(--primary-dark);
    border-radius: var(--radius-pill);
    margin: 0 auto var(--space-px-24);
    background: var(--surface-interactive);
    box-shadow: var(--shadow-focus);
  }

  .profile-header__avatar {
    width: 100%;
    height: 100%;
    border: var(--border-width-strong) solid var(--background-deep);
    border-radius: var(--radius-pill);
    background: var(--surface);
    object-fit: cover;
  }

  h1 {
    font-size: var(--text-36);
    line-height: var(--leading-44);
  }

  .profile-header__role {
    margin-top: var(--space-px-8);
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: var(--text-18);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-28);
  }

  .profile-header__tagline {
    margin-top: var(--space-px-4);
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-size: var(--type-label-size);
    line-height: var(--leading-22);
  }
</style>
