---
import ContactIcon from "./ContactIcon.astro";
import ProfileLink from "./ProfileLink.astro";
import SocialLinks from "./SocialLinks.astro";
import { siteVersions, socialLinks } from "../data/links";
import { localizedPath, t, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang);
const year = new Date().getFullYear();
const mailbox = socialLinks.mail.replace("mailto:", "");
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__top">
      <div class="footer__profile">
        <ProfileLink {lang} placement="footer" />
        <SocialLinks {lang} variant="footer" />
        <p class="footer__stack">
          {copy.footer.stackLine}<br />
          {copy.footer.builtIn}
        </p>
      </div>

      <div class="footer__menus">
        <section class="footer__menu" aria-labelledby="footer-navigation">
          <h2 id="footer-navigation">{copy.footer.navigationHeading}</h2>
          <a href={localizedPath("/", lang)}>{copy.navigation.home}</a>
          <a href={localizedPath("/projects/", lang)}>{copy.navigation.projects}</a>
          <a href={localizedPath("/contact/", lang)}>{copy.navigation.contact}</a>
        </section>

        <section class="footer__menu" aria-labelledby="footer-legal">
          <h2 id="footer-legal">{copy.footer.legalHeading}</h2>
          <a href={localizedPath("/privacy-policy/", lang)}>{copy.footer.privacyPolicy}</a>
          <a href={localizedPath("/terms-of-use/", lang)}>{copy.footer.termsOfUse}</a>
          <a href={localizedPath("/cookies/", lang)}>{copy.footer.cookiesPolicy}</a>
        </section>

        <section class="footer__menu footer__menu--contact" aria-labelledby="footer-contact">
          <h2 id="footer-contact">{copy.footer.contactHeading}</h2>
          {/*
            `ContactIcon` rather than two more inlined paths. It already owns
            both of these marks for the /card page, already draws them on
            `currentColor` — the point the version chevron below and the hero's
            external-link glyph each had to be rewritten to reach — and sharing
            it is what stops a third copy of the LinkedIn path drifting from
            the other two.

            The LinkedIn row asks for `linkedin-outlined`, not `linkedin`: the
            bare wordmark this footer's own social row already shows, so the two
            columns no longer disagree about which mark LinkedIn is. `linkedin`
            — the glyph inside its container square — stays for /card's tiles,
            which is why this is a second name rather than an edit to that one.
          */}
          <a class="footer__contact" href={socialLinks.mail}>
            <ContactIcon name="email" />
            {mailbox}
          </a>
          {/*
            The word "LinkedIn" has left the visible label, so the accessible
            name has to carry it instead — otherwise this link announces as a
            bare handle with nothing naming where it goes. The visible text is
            kept inside that name (WCAG 2.5.3), so voice control still reaches
            the control by what is written on it.
          */}
          <a
            class="footer__contact"
            href={socialLinks.linkedIn}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${copy.navigation.linkedInProfile} — ${copy.footer.linkedInHandle}`}
          >
            <ContactIcon name="linkedin-outlined" />
            {copy.footer.linkedInHandle}
          </a>
        </section>
      </div>
    </div>

    <div class="footer__divider"></div>

    <div class="footer__bottom">
      <p class="footer__copyright">© {year} {copy.footer.copyright}</p>

      <details class="version-picker">
        <summary aria-label={copy.footer.versionsToggle}>
          {siteVersions.find((version) => version.active)?.label}
          {/*
            Inlined so the mark follows `currentColor` — the same move
            `action-row.css` documents for `.action-primary__icon`, and for the
            same reason. As an <img> it carried a baked `stroke="#ECECED"`,
            authored for the dark canvas, which measures 1.1:1 on the light
            theme's `--background-deep`. The glyph was simply not there.
          */}
          <svg
            class="version-picker__chevron"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M4.6665 9.99984L7.99984 13.3332L11.3332 9.99984M4.6665 5.99984L7.99984 2.6665L11.3332 5.99984"
            ></path>
          </svg>
        </summary>
        <nav class="version-picker__options" aria-label={copy.footer.versionsLabel}>
          {
            siteVersions.map((version) => (
              <a
                href={version.url}
                aria-current={version.active ? "page" : undefined}
                class:list={[version.active && "version-picker__active"]}
              >
                {version.label}
              </a>
            ))
          }
        </nav>
      </details>

      <div class="footer__availability">
        <img src="https://cdn.juanpablosilva.com.br/juansilva.design/icons/dot.svg" alt="" width="8" height="8" aria-hidden="true" />
        {copy.footer.available}
      </div>
    </div>

    <div class="footer__art" aria-hidden="true">
      <img
        class="footer__art-desktop"
        src="https://cdn.juanpablosilva.com.br/juansilva.design/vectors/site-versions-bg.svg"
        alt=""
        width="1416"
        height="204"
        loading="lazy"
      />
      <img
        class="footer__art-mobile"
        src="https://cdn.juanpablosilva.com.br/juansilva.design/vectors/site-versions-bg-mobile.svg"
        alt=""
        width="335"
        height="140"
        loading="lazy"
      />
    </div>
  </div>
</footer>

<style>
  .footer {
    width: 100%;
    background: var(--background);
  }

  .footer__inner {
    display: flex;
    max-width: var(--container-page);
    flex-direction: column;
    gap: var(--space-px-24);
    margin: 0 auto;
    padding: 0 var(--space-px-24);
  }

  .footer__top,
  .footer__profile,
  .footer__menu {
    display: flex;
    flex-direction: column;
  }

  .footer__top {
    gap: var(--space-px-24);
    padding: var(--space-px-48) 0 var(--space-px-24);
  }

  .footer__profile {
    width: 100%;
    align-items: center;
    gap: var(--space-px-8);
  }

  .footer__stack,
  .footer__copyright {
    color: var(--text-secondary);
    font-size: var(--type-label-size);
    line-height: var(--leading-22);
    text-align: center;
  }

  .footer__menus {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-px-16);
    text-align: center;
  }

  .footer__menu {
    width: 100%;
    max-width: var(--footer-control-mobile);
  }

  .footer__menu--contact {
    max-width: var(--footer-control-tablet);
  }

  .footer__menu h2,
  .footer__menu a {
    padding: var(--space-px-12) var(--space-px-16);
  }

  .footer__menu h2 {
    color: var(--text-heading);
    font-family: var(--font-body);
    font-size: var(--text-20);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-28);
  }

  .footer__menu a {
    color: var(--text-primary);
    font-family: var(--font-body);
    transition: color var(--motion-base) var(--ease-standard);
  }

  .footer__menu a:hover {
    color: var(--text-heading);
  }

  /*
   * The contact column is the one menu whose rows carry a mark. `inline-flex`
   * blockifies to `flex` here — these are flex items of `.footer__menu` — so
   * the row still fills the column and `justify-content` is what has to echo
   * the `text-align` the other two menus use, centred until the 1024px switch
   * to a left-aligned footer.
   */
  .footer__contact {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-px-8);
  }

  /*
   * `:global`, because the mark is rendered by ContactIcon and carries that
   * component's scope, not this one's. It ships at 24px for the /card page's
   * 48px tiles; in a text row it sizes to the label beside it.
   */
  .footer__contact :global(svg) {
    width: var(--space-px-16);
    height: var(--space-px-16);
    flex: none;
  }

  .footer__divider {
    width: 100%;
    height: var(--border-width);
    border-radius: var(--radius-pill);
    background: var(--border-default);
  }

  .footer__bottom {
    display: grid;
    align-items: center;
    justify-items: center;
    gap: var(--space-px-16);
    padding-top: var(--space-px-24);
  }

  .footer__availability,
  .version-picker summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-ui);
    font-size: var(--type-label-size);
    line-height: var(--type-label-leading);
  }

  .footer__availability {
    gap: var(--space-px-6);
    padding: var(--space-px-4) var(--space-px-10);
    border: var(--border-width) solid var(--border-default);
    border-radius: var(--radius-control);
    background: var(--background-deep);
    color: var(--text-primary);
    font-weight: var(--font-weight-medium);
    grid-row: 1;
  }

  .footer__availability img {
    width: var(--space-px-8);
    height: var(--space-px-8);
  }

  .version-picker {
    position: relative;
    z-index: var(--z-content);
    grid-row: 2;
  }

  .version-picker summary {
    gap: var(--space-px-4);
    padding: var(--space-px-6) var(--space-px-8) var(--space-px-6) var(--space-px-16);
    border: var(--border-width) solid var(--border-subtle);
    border-radius: var(--radius-pill);
    background: var(--background-deep);
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    transition: background-color var(--motion-fast) var(--ease-standard);
  }

  .version-picker summary::-webkit-details-marker {
    display: none;
  }

  .version-picker summary:hover {
    background: var(--surface-hover);
  }

  .version-picker__chevron {
    width: var(--space-px-16);
    height: var(--space-px-16);
    flex: none;
  }

  .version-picker__options {
    position: absolute;
    bottom: calc(100% + var(--space-px-8));
    left: 50%;
    display: flex;
    min-width: var(--space-px-96);
    flex-direction: column;
    overflow: hidden;
    border: var(--border-width) solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--background-deep);
    box-shadow: var(--shadow-dropdown);
    transform: translateX(-50%);
  }

  .version-picker__options a {
    padding: var(--space-px-12) var(--space-px-16);
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-size: var(--type-label-size);
    text-align: center;
    transition:
      background-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .version-picker__options a:hover {
    background: var(--surface-hover);
    color: var(--text-heading);
  }

  .version-picker__options .version-picker__active {
    color: var(--text-heading);
    font-weight: var(--font-weight-medium);
  }

  .footer__copyright {
    grid-row: 3;
  }

  .footer__art {
    position: relative;
    display: flex;
    width: 100%;
    min-height: var(--space-px-24);
    justify-content: center;
  }

  .footer__art img {
    position: absolute;
    z-index: var(--z-background);
    width: 100%;
    max-width: none;
    height: auto;
    filter: var(--decorative-art-filter);
    object-fit: cover;
  }

  .footer__art-desktop {
    display: none;
  }

  .footer__art-mobile {
    top: calc(var(--space-px-140) * -1);
    display: block;
  }

  @media (min-width: 640px) {
    .footer__inner {
      padding-right: var(--space-px-48);
      padding-left: var(--space-px-48);
    }

    .footer__menus {
      gap: 0;
    }

    .footer__menu {
      max-width: var(--footer-control-tablet);
    }

    .footer__bottom {
      grid-template-columns: 1fr auto 1fr;
      justify-items: stretch;
      padding: var(--space-px-24) 0;
    }

    .footer__copyright,
    .version-picker,
    .footer__availability {
      grid-row: 1;
    }

    .footer__copyright {
      justify-self: start;
      text-align: left;
    }

    .version-picker {
      justify-self: center;
    }

    .footer__availability {
      justify-self: end;
    }

    .footer__art-desktop {
      top: calc(var(--space-px-82) * -1);
      display: block;
    }

    .footer__art-mobile {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .footer__inner {
      padding-right: var(--space-px-80);
      padding-left: var(--space-px-80);
    }

    .footer__top {
      flex-direction: row;
      justify-content: space-between;
      gap: var(--space-px-48);
    }

    .footer__profile {
      max-width: var(--footer-column);
      align-items: flex-start;
    }

    .footer__stack {
      text-align: left;
    }

    .footer__menus {
      justify-content: flex-end;
      gap: var(--space-px-48);
      text-align: left;
    }

    .footer__menu,
    .footer__menu--contact {
      width: auto;
      max-width: none;
    }

    /* Follows the `text-align: left` the menus take at this breakpoint. */
    .footer__contact {
      justify-content: flex-start;
    }
  }

  @media (min-width: 1536px) {
    .footer__inner {
      padding-right: var(--section-padding-wide);
      padding-left: var(--section-padding-wide);
    }
  }
</style>
