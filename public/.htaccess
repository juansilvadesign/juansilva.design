# Safer defaults
Options -Multiviews

# Performance Headers
<IfModule mod_headers.c>
  # Enable GZIP compression
  Header set Vary "Accept-Encoding"

  # Cache control for static assets
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Cache control for HTML files
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Content-Security-Policy — ported from public/_headers on 2026-08-12.
  # `_headers` is a Cloudflare Pages file; this origin is Apache and never reads
  # it, so the policy declared there had never actually been served. Kept
  # byte-identical to the value in `_headers` so the two cannot drift. If the
  # site later moves to Pages, `_headers` takes over and this becomes the
  # redundant copy rather than the only one.
  #
  # Verified against the build before shipping: every external origin in the
  # HTML is a plain <a href> (navigation, which CSP does not gate); all four
  # @font-face sources are self-hosted under /assets/fonts/; there are zero
  # <script> tags and zero inline handlers; and the single inline <style> block
  # is covered by style-src 'unsafe-inline'.
  #
  # ⛔ One line on purpose. A continuation backslash that picks up trailing
  #    whitespace makes .htaccess fatal for the whole docroot, and this host is
  #    uploaded by hand — recovery would mean a second manual upload.
  #
  # 🔴 `form-action` must name the contact Worker (2026-08-12, milestone G).
  #    The contact form posts cross-origin to form.juanpablosilva.com.br. Native
  #    form posts are NOT subject to CORS — that part of the G analysis holds —
  #    but `form-action` is a SEPARATE gate that does police exactly this, and it
  #    went live with A7 nine days after that analysis was written. With plain
  #    'self' the browser blocks the submission before any request leaves: no
  #    network entry, no error page, only a console violation. Silent by design.
  # ⚠️ Milestone H must add the new domain here as well as in send.ts and on the
  #    Turnstile widget, or the form dies the moment the domain flips.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self' https://form.juanpablosilva.com.br; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.clarity.ms https://scripts.clarity.ms https://c.bing.com; frame-src https://challenges.cloudflare.com https://www.googletagmanager.com; connect-src 'self' https://challenges.cloudflare.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://stats.g.doubleclick.net https://*.clarity.ms https://c.bing.com https://*.bing.com; img-src 'self' data: https:; media-src 'self' https://cdn.juanpablosilva.com.br; style-src 'self' 'unsafe-inline'; font-src 'self' https://cdn.juanpablosilva.com.br; upgrade-insecure-requests"
</IfModule>

# Enable compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
</IfModule>

RewriteEngine On
RewriteBase /

# Origin Firewall — Cloudflare edge secret header verification.
# LiteSpeed restores the visitor IP into REMOTE_ADDR, so IP allowlists match
# the visitor and 403 the site. This shared secret header injected by a
# Cloudflare Transform Rule enforces that requests came through Cloudflare.
# ⛔ MUST exempt /.well-known/ — AutoSSL renewal hits this directly.
# Using THE_REQUEST ensures internal subrequests (like 404 ErrorDocument) don't override the exemption.
RewriteCond %{THE_REQUEST} !^[A-Z]+\s+/\.well-known/ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
RewriteCond %{HTTP:X-Origin-Verification} !^a7cf7183000d0ee2213a76989c69293da2a9f8e7e8d16cbd1be4af5b6f5e5921$
RewriteRule ^ - [F,L]

# Assets offloaded to Cloudflare R2 CDN
RewriteRule ^assets/(.*)$ https://cdn.juanpablosilva.com.br/juansilva.design/$1 [R=301,L]

# Root -> index.html
RewriteRule ^$ index.html [L]

# Let existing files/dirs pass through untouched.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Extensionless URLs -> the matching .html, when one exists.
# Astro's default `directory` build format emits `<route>/index.html`, which
# mod_dir's DirectorySlash already resolves, so this only catches root-level
# files like /404.html. Kept because it is harmless and covers both formats.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# 404 handling.
# ⛔ Was: `RewriteRule ^.*$ /nao-encontrada/ [L]` — a Next.js-era Portuguese
# route that the Astro build does NOT emit, so every miss rewrote to a path
# that did not exist and fell through to the host's generic error page; the
# custom 404 page was unreachable in production. A RewriteRule was also the
# wrong tool: it returns **200** with the 404 body. ErrorDocument serves the
# same page with a correct 404 status, and needs no rewrite at all.
ErrorDocument 404 /404.html

# Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# (A second mod_deflate block used to sit here declaring a strict subset of the
#  types already covered above. Removed as dead weight, not as a behaviour change.)
