# Deploy config for scripts/deploy.mjs — copy to .env.deploy and fill in.
# .env.deploy is gitignored. This repo is PUBLIC; never commit real values.

# ⛔ The transport is FTP, not SSH. SSH connects to this host and rsync works,
#    but the cPanel account is near its LVE "number of processes" cap, and that
#    cap refuses processes ACCOUNT-WIDE — every site on the account goes down
#    together. The script holds ONE FTP connection for the whole run for the
#    same reason. Working is not the same as allowed: do not port this back.
CPANEL_FTP_HOST=<cpanel-host>
CPANEL_FTP_PORT=21
CPANEL_FTP_USER=your-cpanel-user
CPANEL_FTP_PASSWORD=your-ftp-password

# Optional. FTPS (explicit AUTH TLS) is the default and the connection falls back
# to encrypted-but-unverified if the host's certificate cannot be validated,
# saying so out loud. Set to false ONLY to force plaintext FTP — which puts the
# password on the wire in the clear.
# CPANEL_FTP_TLS=false

# Absolute docroot path on the host. The script mirrors dist/ into this directory
# and DELETES anything there that is not in dist/, so double-check it before the
# first real run. pure-ftpd chroots the login, so the script also tries this path
# with the /home/<user> prefix stripped, and prints which one it entered.
CPANEL_DOCROOT=/home/your-cpanel-user/domains/mydomains/example.com/example.com

# Set to true ONLY when the FTP login is a per-directory cPanel FTP account whose
# home IS the docroot. Such a login is chrooted, so CPANEL_DOCROOT becomes "/" and
# cannot name the site — this waives that one check (the credential is the scope).
# Refusing to mirror into a cPanel account home is NOT waived by this, ever.
# CPANEL_FTP_SCOPED=true

# The cPanel ACCOUNT name, only needed when it differs from CPANEL_FTP_USER — which
# it does whenever the FTP login above is a per-directory account. Used for the
# process-quota preflight, never for the transfer.
# CPANEL_API_USER=your-cpanel-user

# Optional. A cPanel API token (cPanel → Security → Manage API Tokens) lets the
# script read the account's LVE process count over HTTPS:2083 before connecting,
# and refuse to deploy when there are almost no process slots left. Without it
# that preflight is skipped silently.
CPANEL_API_TOKEN=your-cpanel-api-token

# Public origins used for post-deploy verification. Both are checked: the apex
# and www serve byte-identical pages and neither redirects to the other.
SITE_ORIGIN=https://juanpablosilva.com.br
SITE_WWW_ORIGIN=https://www.juanpablosilva.com.br

# The contact Worker endpoint the built form must post to.
FORM_ENDPOINT=https://form.juanpablosilva.com.br/api/send
